<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Stampeded.UrlPromptWindow"
        Title="Open from URL" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False">
  <StackPanel Margin="12" Spacing="8">
    <TextBlock TextWrapping="Wrap" Opacity="0.8"
               Text="GitHub repository or pull request URL (also accepts owner/repo). A repository not cloned yet is cloned via gh into ~/Projects." />
    <TextBox x:Name="UrlBox" Watermark="https://github.com/owner/repo/pull/123" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Open" IsDefault="True" Click="OnOk" />
      <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
