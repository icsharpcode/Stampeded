<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockTheme="using:Dock.Avalonia.Themes.Simple"
             xmlns:local="using:Stampeded"
             x:Class="Stampeded.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Stampeded.EditorBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Stampeded.EditorSelectionBrush" Color="#007ACC" Opacity="0.3" />
          <SolidColorBrush x:Key="Stampeded.TreeFocusFill" Color="#33007ACC" />
          <SolidColorBrush x:Key="Stampeded.TreeFocusBorder" Color="#005A9E" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Stampeded.EditorBackground" Color="#1E1E1E" />
          <SolidColorBrush x:Key="Stampeded.EditorSelectionBrush" Color="#3794FF" Opacity="0.35" />
          <SolidColorBrush x:Key="Stampeded.TreeFocusFill" Color="#40007ACC" />
          <SolidColorBrush x:Key="Stampeded.TreeFocusBorder" Color="#4A90D9" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Stampeded/Controls/TreeView/SharpTreeView.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <SimpleTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Simple/AvaloniaEdit.xaml" />
    <dockTheme:DockSimpleTheme CacheDocumentTabContent="True" />
    <!-- Popups sit in the window's overlay layer, outside the LayoutTransformControl that
         scales its content, so the window zoom never reached them. Scaling their host here
         reaches all of them at once - context menus, tooltips, the comment editor - and from
         the top-left, so a popup still starts where it was placed and grows away from it. -->
    <Style Selector="OverlayPopupHost">
      <Setter Property="RenderTransformOrigin" Value="0%,0%" />
      <Setter Property="RenderTransform" Value="{x:Static local:ZoomState.PopupScale}" />
    </Style>
  </Application.Styles>
</Application>
