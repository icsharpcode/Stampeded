<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:local="using:Stampeded"
        xmlns:docs="using:Stampeded.Documents"
        x:Class="Stampeded.MainWindow"
        x:DataType="local:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1200" Height="800">
  <Window.DataTemplates>
    <local:ViewLocator />
  </Window.DataTemplates>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Review">
        <MenuItem Header="Next Hunk" InputGesture="N" Click="OnNextHunk" />
        <MenuItem Header="Previous Hunk" InputGesture="P" Click="OnPrevHunk" />
        <Separator />
        <MenuItem Header="Next File  ( ] )" Click="OnNextFile" />
        <MenuItem Header="Previous File  ( [ )" Click="OnPrevFile" />
        <Separator />
        <MenuItem Header="Toggle Viewed + Advance" InputGesture="V" Click="OnToggleViewed" />
        <MenuItem Header="Toggle Blame Margin" InputGesture="B" Click="OnToggleBlame" />
        <MenuItem Header="Comment at Caret" InputGesture="C" Click="OnCommentAtCaret" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Review Wizard" Click="OnOpenWizard" />
        <Separator />
        <MenuItem Header="Side-by-Side of Current File" Click="OnSideBySide" />
        <Separator />
        <MenuItem Header="Files Pane" Tag="Files" Click="OnShowPane" />
        <MenuItem Header="Change Map Pane" Tag="Map" Click="OnShowPane" />
        <MenuItem Header="File Browser Pane" Tag="Browser" Click="OnShowPane" />
        <MenuItem Header="References Pane" Tag="References" Click="OnShowPane" />
        <MenuItem Header="Comments Pane" Tag="Comments" Click="OnShowPane" />
        <MenuItem Header="Checks Pane" Tag="Checks" Click="OnShowPane" />
        <MenuItem Header="Tests Pane" Tag="Tests" Click="OnShowPane" />
        <MenuItem Header="Commits Pane" Tag="Commits" Click="OnShowPane" />
        <MenuItem Header="History Pane" Tag="History" Click="OnShowPane" />
        <MenuItem Header="Run Pane" Tag="Run" Click="OnShowPane" />
        <MenuItem Header="Log Pane" Tag="Log" Click="OnShowPane" />
      </MenuItem>
      <MenuItem Header="Re_pository">
        <MenuItem Header="Open Repository..." Click="OnOpenRepository" />
        <MenuItem Header="Open from URL..." Click="OnOpenFromUrl" />
        <MenuItem Header="Recent Repositories" x:Name="RecentMenu" ItemsSource="{Binding Recent}" />
        <Separator />
        <MenuItem Header="Open PR on GitHub" Click="OnOpenOnGitHub" />
        <MenuItem Header="Rebase PR onto Target Branch" Click="OnRebasePr" />
        <MenuItem Header="Show Interdiff Since Last Pass" Click="OnInterdiff" />
        <MenuItem Header="Show Semantic Load Log" Click="OnShowSemanticLog" />
        <MenuItem Header="Prune Worktree Cache" Click="OnPruneWorktrees" />
      </MenuItem>
      <MenuItem Header="_Navigate">
        <MenuItem Header="Go to Definition" InputGesture="F12" Click="OnGoToDefinition" />
        <MenuItem Header="Find References" InputGesture="Shift+F12" Click="OnFindReferences" />
        <MenuItem Header="Highlight Occurrences (click; Esc clears)" Click="OnHighlightOccurrences" />
        <Separator />
        <MenuItem Header="Back" InputGesture="Alt+Left" Click="OnBack" />
        <MenuItem Header="Forward" InputGesture="Alt+Right" Click="OnForward" />
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Padding="6,2" BorderThickness="0,0,0,1" BorderBrush="#30808080"
            DataContext="{Binding Wizard}" IsVisible="{Binding State.HasReview, FallbackValue=False}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
          <Button Content="Next" FontSize="11" Padding="7,1" Click="OnStripNext" FontWeight="SemiBold" />
          <Button Content="Skip" FontSize="11" Padding="7,1" Click="OnStripSkip" />
        </StackPanel>
        <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Steps}" VerticalAlignment="Center">
          <ItemsControl.Styles>
            <Style Selector="Button.strip">
              <Setter Property="FontSize" Value="11" />
              <Setter Property="Padding" Value="6,1" />
              <Setter Property="Margin" Value="1,0" />
              <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style Selector="Button.strip.done">
              <Setter Property="Foreground" Value="#2EA043" />
            </Style>
            <Style Selector="Button.strip.current">
              <Setter Property="FontWeight" Value="Bold" />
              <Setter Property="BorderBrush" Value="#3794FF" />
              <Setter Property="BorderThickness" Value="0,0,0,2" />
            </Style>
          </ItemsControl.Styles>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="strip" Classes.current="{Binding IsCurrent}" Classes.done="{Binding IsSatisfied}"
                      Content="{Binding Title}" Click="OnStripStepClick" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Margin="10,0" FontSize="11" Opacity="0.75" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Text="{Binding State.CurrentFact}" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="8,3" IsVisible="{Binding Busy.IsBusy}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding Busy.SpinnerFrame}" FontFamily="monospace" />
        <TextBlock Text="{Binding Busy.Text}" Opacity="0.8" />
      </StackPanel>
    </Border>
    <Panel>
      <dock:DockControl Layout="{Binding Layout}" IsVisible="{Binding ShowDock}" />
      <docs:WizardView DataContext="{Binding Wizard}" IsVisible="{Binding !$parent[Window].((local:MainViewModel)DataContext).ShowDock}" />
      <!-- Workspace preparation: a modal overlay, not a review phase. -->
      <Border Background="#90000000" IsVisible="{Binding Wizard.State.IsPreparing, FallbackValue=False}">
        <Border Background="{DynamicResource ThemeBackgroundBrush}" CornerRadius="6" Padding="18,14"
                MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#3794FF" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock FontWeight="SemiBold" FontSize="14" Text="Preparing the review workspace" />
            <ItemsControl ItemsSource="{Binding Wizard.PrepareItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="docs:PrepareItem">
                  <DockPanel Margin="2,3">
                    <Panel DockPanel.Dock="Left" Width="22">
                      <TextBlock Text="✓" FontWeight="Bold" Foreground="#2EA043" IsVisible="{Binding Done}" />
                      <TextBlock Text="..." Opacity="0.6" IsVisible="{Binding !Done}" />
                    </Panel>
                    <TextBlock DockPanel.Dock="Right" Opacity="0.7" FontSize="12" Margin="12,0,0,0"
                               Text="{Binding Status}" />
                    <TextBlock Text="{Binding Label}" FontSize="13" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Continue now" Click="OnContinueFromPrepare" HorizontalAlignment="Right"
                    ToolTip.Tip="Start assessing without waiting; loading continues in the background" />
          </StackPanel>
        </Border>
      </Border>
    </Panel>
  </DockPanel>
</Window>
