<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             xmlns:app="using:Stampeded"
             x:Class="Stampeded.Panes.ExplorerPaneView"
             x:DataType="panes:ExplorerPaneViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Margin" Value="6,4,0,2" />
    </Style>
  </UserControl.Styles>
  <!-- Each section owns its heading, so the splitter's neighbours are the two resizable
       areas. With a heading in a row of its own next to the splitter, dragging resized that
       heading instead of the tree below it: the list shrank and the space became a gap. -->
  <Grid RowDefinitions="Auto,2*,4,3*">
    <!-- While stepping, the commit is what the list below contains, so the stepper sits
         with it rather than somewhere the reader has to go back to. -->
    <!-- A scope is not a detail of the header, it is what everything below the header means,
         so each one is worth a colour of its own rather than a sentence to read: the header
         is washed in it and the badge is painted with it. -->
    <Border Grid.Row="0" Padding="6,3" BorderThickness="0,0,0,1"
            Background="{x:Static app:ScopePalette.Tint}" BorderBrush="{x:Static app:ScopePalette.Accent}"
            IsVisible="{Binding HasReview}">
      <StackPanel Spacing="3">
        <!-- First in the pane, above everything that changes height: the commit message
             opens and closes and every commit has a different one, and a row of commands that
             moves under the pointer as it does is a row that gets mis-pressed. Wrapped, too:
             the pane is narrow, and a command that falls off its right edge is the same as
             not having it here at all. -->
        <WrapPanel Orientation="Horizontal">
          <!-- The tip sits on a wrapper rather than on the button, and the wrapper is filled
               with a transparent brush so it is there to be pointed at. A disabled control
               answers no hit test in Avalonia, so a tip on one is a tip nobody can read - and
               the reason a scope is not on offer is exactly what the reader of a greyed button
               is asking. ShowOnDisabled keeps it up while the button under it is dead. -->
          <Border Background="Transparent" IsVisible="{Binding !InScope}"
                  ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding CommitScopeTip}">
            <Button Classes="tool" Click="OnEnterCommitScope"
                    IsEnabled="{Binding CanEnterCommitScope}">
              <Image Source="{x:Static app:Images.Commit}" />
            </Button>
          </Border>
          <Border Background="Transparent" IsVisible="{Binding !InScope}"
                  ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding SinceLastPassTip}">
            <Button Classes="tool" Click="OnSinceLastPass"
                    IsEnabled="{Binding CanEnterSinceLastPass}">
              <Image Source="{x:Static app:Images.History}" />
            </Button>
          </Border>
          <!-- Where that pass starts. Beside the button rather than only in the menu bar: the
               answer differs by how a reader works, and it is chosen while looking at what it
               would show. -->
          <Button Classes="tool" Padding="1,0" Click="OnPassBaselineDropdown"
                  IsVisible="{Binding !InScope}" ToolTip.Tip="Choose what your last pass was">
            <TextBlock Text="&#x25BE;" FontSize="10" VerticalAlignment="Center" />
          </Button>
          <Button Classes="tool" Click="OnPreviousCommit" IsVisible="{Binding InCommitScope}"
                  ToolTip.Tip="Previous commit  ( Ctrl+[ )">
            <Image Source="{x:Static app:Images.Previous}" />
          </Button>
          <Button Classes="tool" Click="OnNextCommit" IsVisible="{Binding InCommitScope}"
                  ToolTip.Tip="Next commit  ( Ctrl+] )">
            <Image Source="{x:Static app:Images.Next}" />
          </Button>
          <Button Classes="tool" Click="OnExitCommitScope" IsVisible="{Binding InScope}"
                  ToolTip.Tip="Whole change - stop reading a part of it and read it as one diff">
            <Image Source="{x:Static app:Images.Diff}" />
          </Button>
          <Border Classes="toolsep" />
          <!-- Verification and close-out, the commands used repeatedly during a pass. -->
          <Button Classes="tool" Click="OnOpenVsCode"
                  ToolTip.Tip="Open the head worktree in VS Code for building and debugging this revision">
            <Image Source="{x:Static app:Images.VisualStudioCode}" />
          </Button>
          <Button Classes="tool" Click="OnOpenOnGitHub" IsVisible="{Binding HasPullRequest}"
                  ToolTip.Tip="Open this pull request in the browser">
            <Image Source="{x:Static app:Images.GitHub}" />
          </Button>
          <Button Classes="tool" Click="OnOpenReview"
                  ToolTip.Tip="Approve / Decline - every comment under the lines it is about, and the verdict">
            <Image Source="{x:Static app:Images.Checkmark}" />
          </Button>
          <Border Classes="toolsep" />
          <Button Classes="tool" Click="OnReloadReview"
                  ToolTip.Tip="Reload - read the review again at the head it has now, picking up commits pushed since it was opened  ( F5 )">
            <Image Source="{x:Static app:Images.Refresh}" />
          </Button>
          <Button Classes="tool" Click="OnCloseReview"
                  ToolTip.Tip="Close review - close its documents and return to the start page">
            <Image Source="{x:Static app:Images.Close}" />
          </Button>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding InScope}">
          <Border Background="{x:Static app:ScopePalette.Accent}" CornerRadius="2"
                  Padding="5,1" VerticalAlignment="Center">
            <TextBlock Text="{Binding ScopeBadge}" FontSize="9" FontWeight="Bold"
                       Foreground="White" />
          </Border>
          <!-- The commit read on its own is worth naming by its hash: it is what an author
               is told to look at, and what a checkout needs. Clicking opens it on GitHub. -->
          <Button Background="Transparent" Padding="2,0" Cursor="Hand" Click="OnOpenCommitOnGitHub"
                  IsVisible="{Binding ShortSha, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  ToolTip.Tip="Open this commit on GitHub">
            <TextBlock Text="{Binding ShortSha}" FontFamily="monospace" FontSize="10" />
          </Button>
        </StackPanel>
        <TextBlock FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"
                   IsVisible="{Binding !InCommitScope}"
                   Text="{Binding CommitScopeLine}" />
        <!-- In per-commit mode the header opens onto the whole message: the reasoning is
             what the commit was written to carry, and it is worth reading before its diff.
             Collapsed it is the same one-line header as before, and a long message scrolls
             inside its own box rather than pushing the file list off the pane. -->
        <Expander IsVisible="{Binding InCommitScope}" IsExpanded="True" Padding="0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <Expander.Header>
            <TextBlock FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="{Binding CommitScopeLine}" />
          </Expander.Header>
          <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock Text="{Binding CommitMessage}" TextWrapping="Wrap"
                                 FontFamily="monospace" FontSize="11" Margin="4,2" />
          </ScrollViewer>
        </Expander>
      </StackPanel>
    </Border>
    <DockPanel Grid.Row="1">
      <TextBlock DockPanel.Dock="Top" Classes="section" Text="{Binding ChangedFilesHeader}" />
      <panes:PrFilesPaneView x:Name="FilesSection" DataContext="{Binding Files}" />
    </DockPanel>
    <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#30808080" />
    <DockPanel Grid.Row="3">
      <TextBlock DockPanel.Dock="Top" Classes="section" Text="REPOSITORY" />
      <panes:FileBrowserPaneView x:Name="BrowserSection" DataContext="{Binding Browser}" />
    </DockPanel>
  </Grid>
</UserControl>
