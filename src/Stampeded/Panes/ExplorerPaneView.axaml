<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             x:Class="Stampeded.Panes.ExplorerPaneView"
             x:DataType="panes:ExplorerPaneViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Margin" Value="6,4,0,2" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,2*,4,Auto,3*">
    <TextBlock Grid.Row="0" Classes="section" Text="CHANGED FILES" />
    <panes:PrFilesPaneView Grid.Row="1" DataContext="{Binding Files}" />
    <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#30808080" />
    <TextBlock Grid.Row="3" Classes="section" Text="REPOSITORY" />
    <panes:FileBrowserPaneView Grid.Row="4" DataContext="{Binding Browser}" />
  </Grid>
</UserControl>
