<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             x:Class="Stampeded.Panes.ExplorerPaneView"
             x:DataType="panes:ExplorerPaneViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Margin" Value="6,4,0,2" />
    </Style>
  </UserControl.Styles>
  <!-- Each section owns its heading, so the splitter's neighbours are the two resizable
       areas. With a heading in a row of its own next to the splitter, dragging resized that
       heading instead of the tree below it: the list shrank and the space became a gap. -->
  <Grid RowDefinitions="Auto,2*,4,3*">
    <!-- While stepping, the commit is what the list below contains, so the stepper sits
         with it rather than somewhere the reader has to go back to. -->
    <Border Grid.Row="0" Padding="6,3" BorderThickness="0,0,0,1" BorderBrush="#803794FF"
            IsVisible="{Binding HasReview}">
      <StackPanel Spacing="3">
        <TextBlock FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="{Binding CommitScopeLine}" />
        <!-- Wrapped: the pane is narrow, and a command that falls off its right edge is
             the same as not having it here at all. -->
        <WrapPanel Orientation="Horizontal">
          <Button Content="Commit by commit" FontSize="10" Padding="6,1" Margin="0,0,4,3" Click="OnEnterCommitScope"
                  IsVisible="{Binding !InCommitScope}"
                  ToolTip.Tip="Read the change one commit at a time, in the order it was written" />
          <Button Content="Prev" FontSize="10" Padding="6,1" Margin="0,0,4,3" Click="OnPreviousCommit"
                  IsVisible="{Binding InCommitScope}"
                  ToolTip.Tip="Previous commit (Ctrl+[ in a diff)" />
          <Button Content="Next" FontSize="10" Padding="6,1" Margin="0,0,4,3" FontWeight="SemiBold" Click="OnNextCommit"
                  IsVisible="{Binding InCommitScope}"
                  ToolTip.Tip="Next commit (Ctrl+] in a diff)" />
          <Button Content="Whole change" FontSize="10" Padding="6,1" Margin="0,0,4,3" Click="OnExitCommitScope"
                  IsVisible="{Binding InCommitScope}" />
          <!-- Verification and close-out, the commands used repeatedly during a pass. -->
          <Button Content="VS Code" FontSize="10" Padding="6,1" Margin="0,0,4,3" Click="OnOpenVsCode"
                  ToolTip.Tip="Open the head worktree in VS Code for building and debugging this revision" />
          <Button Content="Fixtures in ILSpy" FontSize="10" Padding="6,1" Margin="0,0,4,3" Click="OnOpenFixtures"
                  IsVisible="{Binding HasFixtureTools}"
                  ToolTip.Tip="Open the compiled test-case assemblies this change affects in the ILSpy built from the review head (run the decompiler tests first)" />
          <Button Content="Review record" FontSize="10" Padding="6,1" Margin="0,0,4,3" Click="OnReviewRecord"
                  ToolTip.Tip="Write the close-out artifact: reviewed at which depth, verified how, skipped what" />
          <Button Content="Close review" FontSize="10" Padding="6,1" Margin="0,0,4,3" Click="OnCloseReview"
                  ToolTip.Tip="End this review: close its documents and return to the start page" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <DockPanel Grid.Row="1">
      <TextBlock DockPanel.Dock="Top" Classes="section" Text="CHANGED FILES" />
      <panes:PrFilesPaneView x:Name="FilesSection" DataContext="{Binding Files}" />
    </DockPanel>
    <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#30808080" />
    <DockPanel Grid.Row="3">
      <TextBlock DockPanel.Dock="Top" Classes="section" Text="REPOSITORY" />
      <panes:FileBrowserPaneView x:Name="BrowserSection" DataContext="{Binding Browser}" />
    </DockPanel>
  </Grid>
</UserControl>
