<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             x:Class="Stampeded.Panes.ExplorerPaneView"
             x:DataType="panes:ExplorerPaneViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Margin" Value="6,4,0,2" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,2*,4,Auto,3*">
    <!-- While stepping, the commit is what the list below contains, so the stepper sits
         with it rather than somewhere the reader has to go back to. -->
    <Border Grid.Row="0" Padding="6,3" BorderThickness="0,0,0,1" BorderBrush="#803794FF"
            IsVisible="{Binding InCommitScope}">
      <StackPanel Spacing="3">
        <TextBlock FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="{Binding CommitScopeLine}" />
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Content="Prev" FontSize="10" Padding="6,1" Click="OnPreviousCommit"
                  ToolTip.Tip="Previous commit (Ctrl+[ in a diff)" />
          <Button Content="Next" FontSize="10" Padding="6,1" FontWeight="SemiBold" Click="OnNextCommit"
                  ToolTip.Tip="Next commit (Ctrl+] in a diff)" />
          <Button Content="Whole change" FontSize="10" Padding="6,1" Click="OnExitCommitScope" />
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="1" Classes="section" Text="CHANGED FILES" />
    <panes:PrFilesPaneView Grid.Row="2" x:Name="FilesSection" DataContext="{Binding Files}" />
    <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="#30808080" />
    <TextBlock Grid.Row="4" Classes="section" Text="REPOSITORY" />
    <panes:FileBrowserPaneView Grid.Row="5" x:Name="BrowserSection" DataContext="{Binding Browser}" />
  </Grid>
</UserControl>
