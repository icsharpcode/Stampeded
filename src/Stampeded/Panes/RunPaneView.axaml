<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             xmlns:app="using:Stampeded"
             x:Class="Stampeded.Panes.RunPaneView"
             x:DataType="panes:RunPaneViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <DockPanel Grid.Row="0" Margin="4">
      <Button DockPanel.Dock="Right" Classes="tool" Click="OnClearClicked"
              ToolTip.Tip="Clear the output">
        <Image Source="{x:Static app:Images.Clear}" />
      </Button>
      <Button DockPanel.Dock="Right" Classes="tool" Click="OnRunClicked"
              ToolTip.Tip="{Binding State.Running, Converter={x:Static panes:RunPaneView.RunButtonTip}}">
        <Image Source="{Binding State.Running, Converter={x:Static panes:RunPaneView.RunButtonIcon}}" />
      </Button>
      <TextBox DockPanel.Dock="Right" Width="180" Margin="4,0,0,0" Text="{Binding State.Arguments}"
               PlaceholderText="app arguments" FontFamily="monospace" />
      <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding State.SelectedProject}"
                HorizontalAlignment="Stretch" />
    </DockPanel>
    <TextBlock Grid.Row="1" Margin="6,2" Opacity="0.7" TextWrapping="Wrap" Text="{Binding State.Status}" />
    <TextBox Grid.Row="2" x:Name="OutputBox" Text="{Binding State.Output}" IsReadOnly="True"
             AcceptsReturn="True" FontFamily="monospace" FontSize="11" TextWrapping="Wrap" />
  </Grid>
</UserControl>
