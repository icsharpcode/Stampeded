<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             x:Class="Stampeded.Panes.TestsPaneView"
             x:DataType="panes:TestsPaneViewModel">
  <Grid RowDefinitions="Auto,Auto,*,2*">
    <DockPanel Grid.Row="0" Margin="4">
      <Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="Clear" Click="OnClearClicked" />
      <Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="Impacted Filter" Click="OnImpactedFilterClicked"
              ToolTip.Tip="Fill the filter with test classes that reference the changed members (from the Map)" />
      <Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="Run A/B" Click="OnRunABClicked"
              ToolTip.Tip="Run the same tests at base and head and compare verdicts (newly failing / fixed / already broken)" />
      <Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="Run + Coverage" Click="OnRunCoverageClicked"
              ToolTip.Tip="Wraps the run with dotnet-coverage and overlays line coverage on the diffs" />
      <Button DockPanel.Dock="Right" Margin="4,0,0,0" Click="OnRunClicked"
              Content="{Binding State.Running, Converter={x:Static panes:TestsPaneView.RunButtonText}}" />
      <TextBox Text="{Binding State.Args}" Watermark="dotnet arguments" FontFamily="monospace" />
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="6,2">
      <TextBlock DockPanel.Dock="Left" FontFamily="monospace" Foreground="#3794FF" Margin="0,0,6,0"
                 Text="{Binding State.Spinner}" IsVisible="{Binding State.Running}" />
      <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding State.Status}" />
    </DockPanel>
    <ListBox Grid.Row="2" x:Name="List" ItemsSource="{Binding Failures}" DoubleTapped="OnDoubleTapped"
             FontFamily="monospace" FontSize="12">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="panes:TestRow">
          <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBox Grid.Row="3" x:Name="OutputBox" Text="{Binding State.Output}" IsReadOnly="True"
             AcceptsReturn="True" FontFamily="monospace" FontSize="11" TextWrapping="Wrap" />
  </Grid>
</UserControl>
