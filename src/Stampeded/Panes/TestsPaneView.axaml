<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             xmlns:app="using:Stampeded"
             x:Class="Stampeded.Panes.TestsPaneView"
             x:DataType="panes:TestsPaneViewModel">
  <Grid RowDefinitions="Auto,Auto,*,2*">
    <DockPanel Grid.Row="0" Margin="4">
      <Button DockPanel.Dock="Right" Classes="tool" Click="OnClearClicked"
              ToolTip.Tip="Clear the output and the failure list">
        <Image Source="{x:Static app:Images.Clear}" />
      </Button>
      <Button DockPanel.Dock="Right" Classes="tool" Click="OnImpactedFilterClicked"
              ToolTip.Tip="Impacted filter - fill the filter with test classes that reference the changed members (from the Map)">
        <Image Source="{x:Static app:Images.Filter}" />
      </Button>
      <Button DockPanel.Dock="Right" Classes="tool" Click="OnRunABClicked"
              ToolTip.Tip="Run A/B - run the same tests at base and head and compare verdicts (newly failing / fixed / already broken)">
        <Image Source="{x:Static app:Images.CompareFiles}" />
      </Button>
      <Button DockPanel.Dock="Right" Classes="tool" Click="OnRunCoverageClicked"
              ToolTip.Tip="Run + coverage - wraps the run with dotnet-coverage and overlays line coverage on the diffs">
        <Image Source="{x:Static app:Images.CodeCoverage}" />
      </Button>
      <Button DockPanel.Dock="Right" Classes="tool" Click="OnRunClicked"
              ToolTip.Tip="{Binding State.Running, Converter={x:Static panes:TestsPaneView.RunButtonTip}}">
        <Image Source="{Binding State.Running, Converter={x:Static panes:TestsPaneView.RunButtonIcon}}" />
      </Button>
      <TextBox Text="{Binding State.Args}" PlaceholderText="dotnet arguments" FontFamily="monospace" />
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="6,2">
      <TextBlock DockPanel.Dock="Left" FontFamily="monospace" Foreground="#3794FF" Margin="0,0,6,0"
                 Text="{Binding State.Spinner}" IsVisible="{Binding State.Running}" />
      <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding State.Status}" />
    </DockPanel>
    <ListBox Grid.Row="2" x:Name="FailureList" ItemsSource="{Binding Failures}" DoubleTapped="OnDoubleTapped"
             FontFamily="monospace" FontSize="12">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="panes:TestRow">
          <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBox Grid.Row="3" x:Name="OutputBox" Text="{Binding State.Output}" IsReadOnly="True"
             AcceptsReturn="True" FontFamily="monospace" FontSize="11" TextWrapping="Wrap" />
  </Grid>
</UserControl>
