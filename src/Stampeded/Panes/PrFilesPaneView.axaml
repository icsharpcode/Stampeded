<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             x:Class="Stampeded.Panes.PrFilesPaneView"
             x:DataType="panes:PrFilesPaneViewModel">
  <DockPanel>
    <CheckBox DockPanel.Dock="Top" Margin="6,2" FontSize="11" Content="Tests first (read the spec before the code)"
              IsChecked="{Binding TestsFirst}" />
    <!-- Rows must fit the pane: an overflowing row scrolled its trailing badges and the
         viewed checkbox out of reach. A name too wide for its indentation loses characters
         out of its middle instead - the end is what tells two files of a pair apart
         (a view from its code-behind, a source file from its generated twin). -->
    <TreeView x:Name="FileTree" ItemsSource="{Binding Roots}" DoubleTapped="OnDoubleTapped"
              SelectionChanged="OnSelectionChanged"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <!-- Open by default: the pane is the review's queue, and a queue that starts folded
         hides what there is to do. A reader can still fold what they are done with. -->
    <TreeView.Styles>
      <Style Selector="TreeViewItem">
        <Setter Property="IsExpanded" Value="True" />
      </Style>
    </TreeView.Styles>
    <TreeView.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Open Diff (click)" Click="OnOpenClicked" />
        <MenuItem Header="Toggle Viewed" Click="OnToggleViewedClicked" />
        <Separator />
      </ContextMenu>
    </TreeView.ContextMenu>
    <TreeView.ItemTemplate>
      <TreeDataTemplate x:DataType="panes:FileNode" ItemsSource="{Binding Children}">
        <!-- The marks are small and fixed, the name takes what is left of the row and trims to
             fit, and the full path is in the row's tooltip either way. A mark that has nothing
             to say takes no width at all: five empty badges with margins of their own had left
             the names with none in a narrow pane. -->
        <DockPanel Margin="2,0" ToolTip.Tip="{Binding ToolTip}">
          <TextBlock DockPanel.Dock="Left" Width="14" FontWeight="Bold" Text="{Binding Entry.Marker}" />
          <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Entry.IsViewed}" Padding="0"
                    IsVisible="{Binding IsFile}"
                    ToolTip.Tip="Viewed (v toggles and advances)" />
          <!-- What was said about the file, and how much of it changed: the two things a
               reader picks the next file by, in the list they pick it from. -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="3"
                      VerticalAlignment="Center" Margin="4,0">
            <TextBlock FontSize="10" Foreground="#2EA043" Text="{Binding Entry.AddedText}"
                       IsVisible="{Binding Entry.AddedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       ToolTip.Tip="Lines added" />
            <TextBlock FontSize="10" Foreground="#F85149" Text="{Binding Entry.RemovedText}"
                       IsVisible="{Binding Entry.RemovedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       ToolTip.Tip="Lines removed" />
            <TextBlock FontSize="10" Foreground="#D29922" Text="{Binding Entry.CommentBadge}"
                       IsVisible="{Binding Entry.CommentBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       ToolTip.Tip="Comments on this file - drafts of this pass and comments already posted" />
            <TextBlock FontSize="10" Foreground="#3794FF" Text="{Binding Entry.SinceBadge}"
                       IsVisible="{Binding Entry.SinceBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       ToolTip.Tip="Touched since your last pass (viewed flag was invalidated)" />
            <TextBlock FontSize="10" Foreground="#F85149" Text="{Binding Entry.CoverageBadge}"
                       IsVisible="{Binding Entry.CoverageBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       ToolTip.Tip="Uncovered added lines from the last coverage run" />
          </StackPanel>
          <TextBlock Text="{Binding Name}" TextTrimming="PrefixCharacterEllipsis" />
        </DockPanel>
      </TreeDataTemplate>
    </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
