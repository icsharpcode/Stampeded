<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             x:Class="Stampeded.Panes.PrFilesPaneView"
             x:DataType="panes:PrFilesPaneViewModel">
  <DockPanel>
    <CheckBox DockPanel.Dock="Top" Margin="6,2" FontSize="11" Content="Tests first (read the spec before the code)"
              IsChecked="{Binding TestsFirst}" />
    <!-- Rows must fit the pane: an overflowing row scrolled its trailing badges and the
         viewed checkbox out of reach. Paths give up whole directory segments instead, so
         the file name - the part being identified - always survives. -->
    <ListBox x:Name="FileList" ItemsSource="{Binding Files}" DoubleTapped="OnDoubleTapped"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Open Diff (double-click)" Click="OnOpenClicked" />
        <MenuItem Header="Toggle Viewed" Click="OnToggleViewedClicked" />
        <Separator />
        <MenuItem Header="Plan: Verify Deeply" Click="OnDepthDeep" />
        <MenuItem Header="Plan: Skim" Click="OnDepthSkim" />
        <MenuItem Header="Plan: Trust" Click="OnDepthTrust" />
      </ContextMenu>
    </ListBox.ContextMenu>
    <ListBox.ItemTemplate>
      <DataTemplate x:DataType="panes:FileEntry">
        <DockPanel Margin="2,0" ToolTip.Tip="{Binding Display}">
          <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsViewed}" Padding="0"
                    ToolTip.Tip="Viewed (v toggles and advances)" />
          <TextBlock DockPanel.Dock="Right" Margin="4,0" FontSize="10" VerticalAlignment="Center"
                     Foreground="#F85149" Text="{Binding CoverageBadge}"
                     ToolTip.Tip="Uncovered added lines from the last coverage run" />
          <TextBlock DockPanel.Dock="Right" Margin="4,0" FontSize="10" VerticalAlignment="Center"
                     Opacity="0.75" Text="{Binding DepthBadge}"
                     ToolTip.Tip="Planned review depth (right-click to set)" />
          <TextBlock DockPanel.Dock="Right" Margin="4,0" FontSize="10" VerticalAlignment="Center"
                     Foreground="#3794FF" Text="{Binding SinceBadge}"
                     ToolTip.Tip="Touched since your last pass (viewed flag was invalidated)" />
          <TextBlock DockPanel.Dock="Left" Width="14" FontWeight="Bold" Text="{Binding Marker}" />
          <TextBlock Text="{Binding Display}" TextTrimming="PathSegmentEllipsis" />
        </DockPanel>
      </DataTemplate>
    </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
