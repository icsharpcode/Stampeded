<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             x:Class="Stampeded.Panes.PrFilesPaneView"
             x:DataType="panes:PrFilesPaneViewModel">
  <ListBox x:Name="List" ItemsSource="{Binding Files}" DoubleTapped="OnDoubleTapped">
    <ListBox.ItemTemplate>
      <DataTemplate x:DataType="panes:FileEntry">
        <DockPanel Margin="2,0">
          <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsViewed}" Padding="0" />
          <TextBlock DockPanel.Dock="Left" Width="14" FontWeight="Bold" Text="{Binding Marker}" />
          <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
