<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             x:Class="Stampeded.Panes.CommentsPaneView"
             x:DataType="panes:CommentsPaneViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <DockPanel Grid.Row="0" Margin="6,4">
      <Button DockPanel.Dock="Right" x:Name="RefreshComments" Content="Refresh" FontSize="10" Padding="6,1" Margin="4,0,0,0"
              Click="OnRefresh" IsEnabled="{Binding State.CanComment}"
              ToolTip.Tip="Re-read the posted comments from GitHub: replies and resolved threads since this review opened" />
      <TextBlock Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding State.Status}" />
    </DockPanel>
    <StackPanel Grid.Row="1" Margin="4" Spacing="4"
                IsVisible="{Binding State.Target, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock FontSize="11" Opacity="0.8" TextWrapping="Wrap" Text="{Binding State.Target}" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="Add Draft" Click="OnAddDraft" />
        <TextBox Text="{Binding State.DraftBody}" AcceptsReturn="True" MaxHeight="80"
                 PlaceholderText="Draft comment text..." />
      </DockPanel>
    </StackPanel>
    <ListBox Grid.Row="2" x:Name="CommentList" ItemsSource="{Binding Items}" SelectionChanged="OnSelectionChanged">
      <ListBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Go to Line (click)" Click="OnGoTo" />
          <MenuItem Header="Delete Draft" Click="OnDelete" />
          <MenuItem Header="Open on GitHub" Click="OnOpenOnGitHub" />
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="panes:CommentRow">
          <Border Margin="2,3" Padding="6,4" CornerRadius="3"
                  BorderThickness="1" BorderBrush="#40808080">
            <StackPanel Spacing="3">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontSize="10" Opacity="0.8"
                           Text="DRAFT" IsVisible="{Binding IsDraft}" />
                <TextBlock FontSize="11" Opacity="0.65" FontFamily="monospace"
                           TextTrimming="CharacterEllipsis" Text="{Binding Header}" />
              </DockPanel>
              <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxLines="3"
                         TextTrimming="CharacterEllipsis" FontSize="12"
                         ToolTip.Tip="{Binding Body}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <DockPanel Grid.Row="3" Margin="4">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0">
        <!-- GitHub rejects a verdict on your own pull request; a comment review is all it takes. -->
        <Button Content="Approve" Click="OnApprove" IsEnabled="{Binding State.CanGiveVerdict}"
                ToolTip.Tip="Approve. GitHub does not allow this on your own pull request." />
        <Button Content="Request Changes" Click="OnRequestChanges" IsEnabled="{Binding State.CanGiveVerdict}"
                ToolTip.Tip="Request changes. GitHub does not allow this on your own pull request." />
        <Button Content="Comment" Click="OnComment" IsEnabled="{Binding State.CanComment}" />
      </StackPanel>
      <TextBox Text="{Binding State.ReviewBody}" AcceptsReturn="True" MaxHeight="60"
               IsEnabled="{Binding State.CanComment}"
               PlaceholderText="Review summary (optional)..." />
    </DockPanel>
  </Grid>
</UserControl>
