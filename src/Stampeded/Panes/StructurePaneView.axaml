<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             x:Class="Stampeded.Panes.StructurePaneView"
             x:DataType="panes:StructurePaneViewModel">
  <UserControl.Styles>
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="True" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <TextBlock DockPanel.Dock="Bottom" Margin="6,4" Opacity="0.7" TextWrapping="Wrap" FontSize="11"
               Text="{Binding State.Status}" />
    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" DoubleTapped="OnDoubleTapped" FontSize="12">
      <TreeView.ItemTemplate>
        <TreeDataTemplate DataType="panes:StructureNode" ItemsSource="{Binding Children}">
          <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground}"
                     FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" />
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
