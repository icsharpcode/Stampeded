<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             xmlns:tv="using:Stampeded.Controls.TreeView"
             x:Class="Stampeded.Panes.FileBrowserPaneView"
             x:DataType="panes:FileBrowserPaneViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Bottom" Margin="6,4" Opacity="0.7" TextWrapping="Wrap"
               Text="{Binding State.Status}" />
    <tv:SharpTreeView x:Name="Tree" Root="{Binding Root}" ShowRoot="False" FontSize="12"
                      PointerPressed="OnPointerPressed">
      <tv:SharpTreeView.ContextMenu>
        <ContextMenu Opening="OnContextMenuOpening">
          <MenuItem Header="Copy File Name" x:Name="CopyFileNameItem" Click="OnCopyFileName" />
          <MenuItem Header="Copy Path" x:Name="CopyPathItem" Click="OnCopyPath" />
          <MenuItem Header="Copy Relative Path" x:Name="CopyRelativePathItem" Click="OnCopyRelativePath" />
        </ContextMenu>
      </tv:SharpTreeView.ContextMenu>
    </tv:SharpTreeView>
  </DockPanel>
</UserControl>
