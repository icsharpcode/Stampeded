<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             x:Class="Stampeded.Panes.FileBrowserPaneView"
             x:DataType="panes:FileBrowserPaneViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Bottom" Margin="6,4" Opacity="0.7" TextWrapping="Wrap"
               Text="{Binding State.Status}" />
    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" DoubleTapped="OnDoubleTapped"
              FontSize="12">
      <TreeView.ItemTemplate>
        <TreeDataTemplate DataType="panes:FsNode" ItemsSource="{Binding Children}">
          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
