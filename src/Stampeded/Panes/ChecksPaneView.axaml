<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             x:Class="Stampeded.Panes.ChecksPaneView"
             x:DataType="panes:ChecksPaneViewModel">
  <DockPanel>
    <DockPanel DockPanel.Dock="Bottom">
      <Button DockPanel.Dock="Right" Content="Refresh" FontSize="10" Padding="5,1" Margin="0,2,4,2"
              VerticalAlignment="Center" Click="OnRefresh"
              ToolTip.Tip="Re-fetch CI check state from GitHub" />
      <TextBlock Margin="6,4" Opacity="0.7" TextWrapping="Wrap" Text="{Binding State.Status}" />
    </DockPanel>
    <ListBox x:Name="List" ItemsSource="{Binding Items}" DoubleTapped="OnDoubleTapped"
             FontFamily="monospace" FontSize="12">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="panes:CheckRow">
          <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
