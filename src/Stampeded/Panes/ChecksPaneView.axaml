<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             xmlns:app="using:Stampeded"
             x:Class="Stampeded.Panes.ChecksPaneView"
             x:DataType="panes:ChecksPaneViewModel">
  <DockPanel>
    <!-- Above the list, like every other pane's commands: a row that sits under a list moves
         with it, and the reader has to look for it. -->
    <DockPanel DockPanel.Dock="Top">
      <Button DockPanel.Dock="Right" Classes="tool" Margin="0,2,4,2"
              VerticalAlignment="Center" Click="OnRefresh"
              ToolTip.Tip="Refresh - re-fetch CI check state from GitHub">
        <Image Source="{x:Static app:Images.Refresh}" />
      </Button>
      <TextBlock Margin="6,4" Opacity="0.7" TextWrapping="Wrap" Text="{Binding State.Status}" />
    </DockPanel>
    <ListBox x:Name="CheckList" ItemsSource="{Binding Items}" DoubleTapped="OnDoubleTapped"
             FontFamily="monospace" FontSize="12">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="panes:CheckRow">
          <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
