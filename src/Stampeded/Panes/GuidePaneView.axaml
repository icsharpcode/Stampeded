<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             x:Class="Stampeded.Panes.GuidePaneView"
             x:DataType="panes:GuidePaneViewModel">
  <UserControl.Styles>
    <Style Selector="Button.phase">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Margin" Value="1,0" />
    </Style>
    <Style Selector="Button.phase.current">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="BorderBrush" Value="#3794FF" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Phases}" Margin="4,3">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="panes:GuidePhase">
          <Button Classes="phase" Classes.current="{Binding IsCurrent}" Click="OnPhaseClick">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <TextBlock Text="{Binding Title}" />
              <TextBlock Text="ok" FontSize="9" Opacity="0.7" VerticalAlignment="Center"
                         IsVisible="{Binding IsSatisfied}" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel DockPanel.Dock="Bottom" Margin="6,4" Spacing="3">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button FontSize="11" Content="Bounce..." Click="OnBounce" IsVisible="{Binding State.IsTriage}"
                ToolTip.Tip="Draft a decline-with-reason review comment" />
        <Button FontSize="11" Content="Review record" Click="OnRecord" IsVisible="{Binding State.IsClose}"
                ToolTip.Tip="Write the close-out artifact: reviewed at which depth, verified how, skipped what" />
        <Button FontSize="11" Content="Next phase" Click="OnNext" />
        <TextBlock FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Text="{Binding State.Progress}" />
      </StackPanel>
      <CheckBox IsChecked="{Binding State.OverrideGate}" FontSize="11"
                Content="Allow approving anyway (override the guide)" />
    </StackPanel>
    <ScrollViewer>
      <StackPanel Margin="4">
        <ItemsControl ItemsSource="{Binding Phases}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="panes:GuidePhase">
              <Border Margin="0,2" Padding="6,4" CornerRadius="3" BorderThickness="1"
                      BorderBrush="#40808080" IsVisible="{Binding IsCurrent}">
                <StackPanel Spacing="4">
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsChecked}" Padding="4,0"
                              IsVisible="{Binding RequiresCheck}" Content="phase done" FontSize="11" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                  </DockPanel>
                  <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap" Text="{Binding Guidance}" />
                  <TextBlock FontSize="11" FontStyle="Italic" Opacity="0.9" TextWrapping="Wrap"
                             Text="{Binding Facts}"
                             IsVisible="{Binding Facts, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ListBox ItemsSource="{Binding SweepItems}" IsVisible="{Binding State.IsSweep}"
                 x:Name="SweepList" DoubleTapped="OnSweepDoubleTapped" FontSize="12" MaxHeight="260">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
