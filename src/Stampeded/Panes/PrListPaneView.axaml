<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Stampeded.Controls"
             xmlns:pr="using:Stampeded.Core.PullRequests"
             xmlns:panes="using:Stampeded.Panes"
             x:Class="Stampeded.Panes.PrListPaneView"
             x:DataType="panes:PrListPaneViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="4" Spacing="4">
      <DockPanel>
        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="Open Range" Click="OnOpenRangeClicked" />
        <TextBox x:Name="RangeBox" PlaceholderText="base..head (local review)" FontFamily="monospace" />
      </DockPanel>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Refresh" Click="OnRefreshClicked" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="0,0,6,0"
                    IsVisible="{Binding State.StatsLoading}">
          <controls:WaveSpinner SquareSize="2.5" Width="32" VerticalAlignment="Center" />
          <TextBlock Text="line counts" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Margin="2,0,6,0" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap"
                   Text="{Binding State.Status}" />
      </DockPanel>
    </StackPanel>
    <ListBox x:Name="PullRequestList" ItemsSource="{Binding Items}" DoubleTapped="OnDoubleTapped">
      <ListBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Open Review (double-click)" Click="OnOpenClicked" />
          <MenuItem Header="{Binding HostName, StringFormat='Open on {0}'}" Click="OnOpenOnHostClicked" />
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="pr:PrSummary">
          <StackPanel Margin="2">
            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding NumberDisplay}" /> <Run Text="{Binding Title}" />
            </TextBlock>
            <TextBlock Opacity="0.6" FontSize="11">
              <Run Text="{Binding Author.Login}" /> · <Run Text="{Binding HeadRefName}" />
            </TextBlock>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
