<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="using:Stampeded.Panes"
             x:Class="Stampeded.Panes.CallGraphPaneView"
             x:DataType="panes:CallGraphPaneViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="6,4,6,2">
      <RadioButton GroupName="CallDirection" Content="Callers" FontSize="12"
                   IsChecked="{Binding State.ShowCallers}"
                   ToolTip.Tip="Who calls this - what a change to it can break" />
      <RadioButton GroupName="CallDirection" Content="Calls out" FontSize="12"
                   ToolTip.Tip="What this member calls - how it does its work" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Margin="6,4" Opacity="0.7" TextWrapping="Wrap" FontSize="11"
               Text="{Binding State.Status}" />
    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" DoubleTapped="OnDoubleTapped" FontSize="12">
      <TreeView.ItemContainerTheme>
        <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
          <Setter Property="IsExpanded"
                  Value="{Binding IsExpanded, Mode=TwoWay, x:DataType=panes:CallGraphNode}" />
        </ControlTheme>
      </TreeView.ItemContainerTheme>
      <TreeView.ItemTemplate>
        <TreeDataTemplate DataType="panes:CallGraphNode" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal">
            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0" />
            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="11" Margin="8,0,0,0"
                       VerticalAlignment="Center" TextTrimming="PathSegmentEllipsis" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
