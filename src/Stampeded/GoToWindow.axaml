<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:Stampeded"
        x:Class="Stampeded.GoToWindow"
        x:DataType="app:GoToWindow"
        Title="Go to" Width="720" Height="420"
        WindowStartupLocation="CenterOwner" CanResize="True"
        ShowInTaskbar="False">
  <DockPanel Margin="10">
    <TextBox x:Name="InputBox" DockPanel.Dock="Top" Margin="0,0,0,6"
             KeyDown="OnInputKeyDown"
             PlaceholderText="File, symbol, line, or name:line - e.g. ThemeManager, RWS, thememan:120, 120" />
    <TextBlock x:Name="HintText" DockPanel.Dock="Bottom" Margin="2,6,0,0" FontSize="11" Opacity="0.7"
               TextWrapping="Wrap" />
    <ListBox x:Name="Matches" ItemsSource="{Binding Rows}" DoubleTapped="OnMatchDoubleTapped"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="app:GoToRow">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" MinWidth="20" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{Binding BadgeBrush}" Text="{Binding Badge}" />
            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Opacity="0.6" FontSize="12"
                       VerticalAlignment="Center" Text="{Binding LineTag}" />
            <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Opacity="0.55" FontSize="11"
                       VerticalAlignment="Center" MaxWidth="330" TextTrimming="CharacterEllipsis"
                       Text="{Binding Detail}" />
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
