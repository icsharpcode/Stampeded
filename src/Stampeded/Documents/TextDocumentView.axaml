<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="using:Stampeded.Editor"
             x:Class="Stampeded.Documents.TextDocumentView">
  <editor:ReviewTextEditor x:Name="Editor" IsReadOnly="True" WordWrap="True">
    <editor:ReviewTextEditor.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Copy" InputGesture="Ctrl+C" Click="OnCtxCopy" />
      </ContextMenu>
    </editor:ReviewTextEditor.ContextMenu>
  </editor:ReviewTextEditor>
</UserControl>
