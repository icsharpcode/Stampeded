<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Stampeded.Documents"
             xmlns:app="using:Stampeded"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             x:Class="Stampeded.Documents.OverviewDocumentView"
             x:DataType="docs:OverviewDocumentViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.blockhead">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontFamily" Value="monospace" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="TextBlock.statusline">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontFamily" Value="monospace" />
    </Style>
    <Style Selector="Expander.block">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Expander.block TextBlock.sectiontitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Expander.block TextBlock.sectiondetail">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Styles>
  <!-- One scroll region for the whole page: every list below grows to its full height and
       the page scrolls past it. A list that scrolls inside a page that also scrolls puts two
       bars side by side and hides rows behind whichever one the wheel does not move. -->
  <!-- The title and its commands stay put: docked above the scroll region rather than at the
       top of it, so opening a section below or scrolling down never moves them. -->
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="8,8,8,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
        <Button Classes="tool" Click="OnEnterCommitScope"
                IsVisible="{Binding !State.InScope}"
                IsEnabled="{Binding State.CanEnterCommitScope}"
                ToolTip.Tip="Commit by commit - read the change one commit at a time, in the order it was written">
          <Image Source="{x:Static app:Images.Commit}" />
        </Button>
        <Button Classes="tool" Click="OnSinceLastPass"
                IsVisible="{Binding !State.InScope}"
                IsEnabled="{Binding State.CanEnterSinceLastPass}"
                ToolTip.Tip="Since last pass - only what changed since you last opened this review; after a rebase, the author's own edits without the commits it brought in">
          <Image Source="{x:Static app:Images.History}" />
        </Button>
        <Border Classes="toolsep" />
        <Button Classes="tool" Click="OnOpenVsCode"
                ToolTip.Tip="Open the head worktree in VS Code for building and debugging this revision">
          <Image Source="{x:Static app:Images.VisualStudioCode}" />
        </Button>
        <Button Classes="tool" Click="OnOpenFixtures" IsVisible="{Binding State.HasFixtureTools}"
                ToolTip.Tip="Fixtures in ILSpy - open the compiled test-case assemblies this change affects in the ILSpy built from the review head (run the decompiler tests first)">
          <Image Source="{x:Static app:Images.Assembly}" />
        </Button>
        <Button Classes="tool" Click="OnOpenPr"
                ToolTip.Tip="Open this PR in the browser">
          <Image Source="{x:Static app:Images.GitHub}" />
        </Button>
        <Border Classes="toolsep" />
        <Button Classes="tool" Click="OnBounce"
                ToolTip.Tip="Bounce - draft a decline-with-reason review comment">
          <Image Source="{x:Static app:Images.Undo}" />
        </Button>
        <Button Classes="tool" Click="OnReloadReview"
                ToolTip.Tip="Reload - read the review again at the head it has now, picking up commits pushed since it was opened  ( F5 )">
          <Image Source="{x:Static app:Images.Refresh}" />
        </Button>
        <Button Classes="tool" Click="OnCloseReview"
                ToolTip.Tip="Close review - close its documents and return to the start page">
          <Image Source="{x:Static app:Images.Close}" />
        </Button>
      </StackPanel>
      <TextBlock FontWeight="SemiBold" FontSize="17" Text="{Binding State.Title}"
                 TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <ScrollViewer Padding="8,4,8,8">
      <StackPanel>
      <!-- The scope takes over the top of the page while it is on: it is what everything
           below refers to. Stepping belongs to the per-commit scope alone; leaving is the
           same for both. -->
      <Border Margin="0,6,0,0" Padding="8,4" CornerRadius="3" BorderThickness="1"
              Background="{x:Static app:ScopePalette.Tint}" BorderBrush="{x:Static app:ScopePalette.Accent}"
              IsVisible="{Binding State.InScope}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
            <Button Classes="tool" Click="OnPreviousCommit" IsVisible="{Binding State.InCommitScope}"
                    ToolTip.Tip="Previous commit  ( Ctrl+[ )">
              <Image Source="{x:Static app:Images.Previous}" />
            </Button>
            <Button Classes="tool" Click="OnNextCommit" IsVisible="{Binding State.InCommitScope}"
                    ToolTip.Tip="Next commit  ( Ctrl+] )">
              <Image Source="{x:Static app:Images.Next}" />
            </Button>
            <Button Classes="tool" Click="OnExitCommitScope"
                    ToolTip.Tip="Whole change - stop reading a part of it and read it as one diff">
              <Image Source="{x:Static app:Images.Diff}" />
            </Button>
          </StackPanel>
          <TextBlock Classes="statusline" FontWeight="SemiBold" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Text="{Binding State.CommitScopeLine}" />
        </DockPanel>
      </Border>
      <TextBlock Classes="statusline" Foreground="#D29922" Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="{Binding State.WorkingTreeLine}"
                 IsVisible="{Binding State.WorkingTreeLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="statusline" Foreground="#D29922" Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="{Binding State.ToolStatus}"
                 IsVisible="{Binding State.ToolStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="statusline" Opacity="0.95" Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="{Binding State.Estimate}"
                 IsVisible="{Binding State.Estimate, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <DockPanel Margin="0,2,0,0">
        <Panel DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock Classes="statusline" FontWeight="SemiBold" Foreground="#F85149"
                     Text="{Binding State.ChecksHeader}" IsVisible="{Binding State.ChecksFailing}" />
          <TextBlock Classes="statusline" FontWeight="SemiBold" Foreground="#2EA043"
                     Text="{Binding State.ChecksHeader}" IsVisible="{Binding State.ChecksGreen}" />
          <TextBlock Classes="statusline" FontWeight="SemiBold" Foreground="#D29922"
                     Text="{Binding State.ChecksHeader}" IsVisible="{Binding State.ChecksPending}" />
          <TextBlock Classes="statusline" Opacity="0.8" Text="{Binding State.ChecksHeader}"
                     IsVisible="{Binding State.ChecksUnknown}" />
        </Panel>
        <Button DockPanel.Dock="Left" Classes="tool" Margin="6,0,0,0"
                VerticalAlignment="Center" Click="OnRefreshChecks"
                ToolTip.Tip="Re-fetch CI check state from GitHub">
          <Image Source="{x:Static app:Images.Refresh}" />
        </Button>
        <ItemsControl ItemsSource="{Binding CheckLines}" Margin="10,0,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="docs:CheckLine">
              <Button Background="Transparent" Padding="2,0" Margin="0,0,8,0" Click="OnCheckClick"
                      Cursor="Hand" ToolTip.Tip="Open this check run on GitHub">
                <TextBlock Classes="mono" Foreground="#F85149">
                  <Run Text="{Binding Marker}" /> <Run Text="{Binding Name}" />
                </TextBlock>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
      <!-- Who has already read this, and what they said of it - which is what a reader
           arriving at a pull request wants before deciding what is left to do. -->
      <DockPanel Margin="0,2,0,0" IsVisible="{Binding State.ReviewersHeader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock DockPanel.Dock="Left" Classes="statusline" Opacity="0.9" VerticalAlignment="Center"
                   Text="Reviews:" />
        <TextBlock DockPanel.Dock="Left" Classes="statusline" Opacity="0.7" VerticalAlignment="Center"
                   Margin="6,0,0,0" Text="{Binding State.ReviewersHeader}" />
        <ItemsControl ItemsSource="{Binding Reviewers}" Margin="10,0,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="docs:ReviewerLine">
              <TextBlock Classes="mono" Margin="0,0,10,0" VerticalAlignment="Center"
                         Foreground="{Binding Foreground}" Text="{Binding Text}"
                         ToolTip.Tip="A verdict shown with a commit was given on an earlier head" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
      <TextBlock Classes="statusline" Opacity="0.95" Margin="0,2,0,0" Text="{Binding State.CoverageLine}" />
      <TextBlock Classes="statusline" Opacity="0.95" Text="{Binding State.TestsLine}" />
      <DockPanel Margin="0,2,0,0" IsVisible="{Binding LinkedIssues.Count}">
        <TextBlock DockPanel.Dock="Left" Classes="statusline" Opacity="0.9" VerticalAlignment="Center"
                   Text="Linked issues:" />
        <ItemsControl ItemsSource="{Binding LinkedIssues}" Margin="6,0,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="docs:IssueRef">
              <Button Content="{Binding Display}" FontSize="12.5" Padding="6,2" Margin="0,0,4,0"
                      Click="OnIssueClick" ToolTip.Tip="Open on GitHub" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>

      <Expander Classes="block" IsExpanded="True">
        <Expander.Header>
          <TextBlock Classes="sectiontitle" Text="Description" />
        </Expander.Header>
        <!-- No height cap: capped, it scrolls the description inside the page instead of
             with it. A description long enough to be in the way folds away with its section. -->
        <md:MarkdownScrollViewer x:Name="DescriptionView" Markdown="{Binding State.Description}" />
      </Expander>

      <Expander Classes="block" IsExpanded="{Binding State.CommitsExpanded}" IsVisible="{Binding State.CommitsHeader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Expander.Header>
          <DockPanel>
            <TextBlock Classes="sectiontitle" Text="Commits" />
            <TextBlock Classes="sectiondetail" Text="{Binding State.CommitsHeader}" />
          </DockPanel>
        </Expander.Header>
        <StackPanel>
          <ListBox x:Name="CommitsList" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding CommitLines}" DoubleTapped="OnCommitDoubleTapped"
                   ToolTip.Tip="Double-click opens the commit on GitHub">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="docs:CommitLine">
                <StackPanel Orientation="Horizontal" ToolTip.Tip="{Binding Message}">
                  <SelectableTextBlock Classes="mono" Opacity="0.7" Width="96" Margin="12,0,0,0"
                                       Text="{Binding ShortSha}" FontWeight="{Binding Weight}" />
                  <TextBlock Classes="mono" Width="56" TextAlignment="Right" Foreground="#2EA043" Text="{Binding Added}" />
                  <TextBlock Classes="mono" Width="52" TextAlignment="Right" Foreground="#F85149" Text="{Binding Removed}" Margin="0,0,10,0" />
                  <SelectableTextBlock Classes="mono" Opacity="0.9" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Expander>

      <Expander Classes="block" IsExpanded="True" IsVisible="{Binding State.FilesHeader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Expander.Header>
          <DockPanel>
            <TextBlock Classes="sectiontitle" Text="Changed files" />
            <TextBlock Classes="sectiondetail" Text="{Binding State.FilesHeader}" />
          </DockPanel>
        </Expander.Header>
        <StackPanel>
          <ListBox x:Name="FilesList" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding FileCosts}" DoubleTapped="OnFileDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="docs:FileCostRow">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="mono" Opacity="0.7" Width="50" Text="{Binding Marker}" />
                  <TextBlock Classes="mono" Width="56" TextAlignment="Right" Foreground="#2EA043" Text="{Binding Added}" />
                  <TextBlock Classes="mono" Width="52" TextAlignment="Right" Foreground="#F85149" Text="{Binding Removed}" />
                  <TextBlock Classes="mono" Width="78" TextAlignment="Right" Opacity="0.9" Text="{Binding Minutes}" Margin="0,0,8,0" />
                  <TextBlock Classes="mono" Width="62" Opacity="0.8" Text="{Binding Churn}" />
                  <TextBlock Classes="mono" Opacity="0.9" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Expander>

      <Expander Classes="block" IsExpanded="False">
        <Expander.Header>
          <DockPanel>
            <TextBlock Classes="sectiontitle" Text="Changed members" />
            <TextBlock Classes="sectiondetail" Text="{Binding State.MembersHeader}" />
          </DockPanel>
        </Expander.Header>
        <StackPanel>
          <ListBox x:Name="ImplList" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding ImplMembers}" DoubleTapped="OnImplDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="docs:MemberRow">
                <TextBlock Classes="mono" Foreground="{Binding Foreground}"
                           Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ListBox x:Name="TestList" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding TestGroups}" DoubleTapped="OnTestDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="docs:MemberRow">
                <TextBlock Classes="mono" Foreground="{Binding Foreground}"
                           Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Expander>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
