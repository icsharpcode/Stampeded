<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Stampeded.Documents"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             x:Class="Stampeded.Documents.OverviewDocumentView"
             x:DataType="docs:OverviewDocumentViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.blockhead">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontFamily" Value="monospace" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="TextBlock.statusline">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontFamily" Value="monospace" />
    </Style>
    <Style Selector="Expander.block">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Expander.block TextBlock.sectiontitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Expander.block TextBlock.sectiondetail">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer Padding="8">
    <StackPanel>
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Content="Open on GitHub" FontSize="11" Click="OnOpenPr"
                  ToolTip.Tip="Open this PR in the browser" />
          <Button Content="VS Code" FontSize="11" Click="OnOpenVsCode"
                  ToolTip.Tip="Open the head worktree in VS Code for building and debugging this revision" />
          <Button Content="Fixtures in ILSpy" FontSize="11" Click="OnOpenFixtures"
                  IsVisible="{Binding State.HasFixtureTools}"
                  ToolTip.Tip="Open the compiled test-case assemblies this change affects in the ILSpy built from the review head (run the decompiler tests first)" />
          <Button Content="Commit by commit" FontSize="11" Click="OnEnterCommitScope"
                  IsVisible="{Binding !State.InCommitScope}"
                  IsEnabled="{Binding State.CanEnterCommitScope}"
                  ToolTip.Tip="Read the change one commit at a time, in the order it was written" />
          <Button Content="Bounce..." FontSize="11" Click="OnBounce"
                  ToolTip.Tip="Draft a decline-with-reason review comment" />
          <Button Content="Close review" FontSize="11" Click="OnCloseReview"
                  ToolTip.Tip="End this review: close its documents and return to the start page" />
        </StackPanel>
        <TextBlock FontWeight="SemiBold" FontSize="17" Text="{Binding State.Title}"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <!-- The commit stepper takes over the top of the page while it is on: it is the
           scope everything below refers to. -->
      <Border Margin="0,6,0,0" Padding="8,4" CornerRadius="3" BorderThickness="1"
              BorderBrush="#803794FF" IsVisible="{Binding State.InCommitScope}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
            <Button Content="Previous" FontSize="11" Click="OnPreviousCommit" />
            <Button Content="Next" FontSize="11" FontWeight="SemiBold" Click="OnNextCommit" />
            <Button Content="Whole change" FontSize="11" Click="OnExitCommitScope"
                    ToolTip.Tip="Stop stepping and review the change as one diff again" />
          </StackPanel>
          <TextBlock Classes="statusline" FontWeight="SemiBold" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Text="{Binding State.CommitScopeLine}" />
        </DockPanel>
      </Border>
      <TextBlock Classes="statusline" Foreground="#D29922" Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="{Binding State.WorkingTreeLine}"
                 IsVisible="{Binding State.WorkingTreeLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="statusline" Foreground="#D29922" Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="{Binding State.ToolStatus}"
                 IsVisible="{Binding State.ToolStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="statusline" Opacity="0.95" Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="{Binding State.Estimate}"
                 IsVisible="{Binding State.Estimate, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <DockPanel Margin="0,2,0,0">
        <Panel DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock Classes="statusline" FontWeight="SemiBold" Foreground="#F85149"
                     Text="{Binding State.ChecksHeader}" IsVisible="{Binding State.ChecksFailing}" />
          <TextBlock Classes="statusline" FontWeight="SemiBold" Foreground="#2EA043"
                     Text="{Binding State.ChecksHeader}" IsVisible="{Binding State.ChecksGreen}" />
          <TextBlock Classes="statusline" FontWeight="SemiBold" Foreground="#D29922"
                     Text="{Binding State.ChecksHeader}" IsVisible="{Binding State.ChecksPending}" />
          <TextBlock Classes="statusline" Opacity="0.8" Text="{Binding State.ChecksHeader}"
                     IsVisible="{Binding State.ChecksUnknown}" />
        </Panel>
        <Button DockPanel.Dock="Left" Content="Refresh" FontSize="10" Padding="5,1" Margin="8,0,0,0"
                VerticalAlignment="Center" Click="OnRefreshChecks"
                ToolTip.Tip="Re-fetch CI check state from GitHub" />
        <ItemsControl ItemsSource="{Binding CheckLines}" Margin="10,0,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="docs:CheckLine">
              <Button Background="Transparent" Padding="2,0" Margin="0,0,8,0" Click="OnCheckClick"
                      Cursor="Hand" ToolTip.Tip="Open this check run on GitHub">
                <TextBlock Classes="mono" Foreground="#F85149">
                  <Run Text="{Binding Marker}" /> <Run Text="{Binding Name}" />
                </TextBlock>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
      <TextBlock Classes="statusline" Opacity="0.95" Margin="0,2,0,0" Text="{Binding State.CoverageLine}" />
      <TextBlock Classes="statusline" Opacity="0.95" Text="{Binding State.TestsLine}" />
      <DockPanel Margin="0,2,0,0" IsVisible="{Binding LinkedIssues.Count}">
        <TextBlock DockPanel.Dock="Left" Classes="statusline" Opacity="0.9" VerticalAlignment="Center"
                   Text="Linked issues:" />
        <ItemsControl ItemsSource="{Binding LinkedIssues}" Margin="6,0,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="docs:IssueRef">
              <Button Content="{Binding Display}" FontSize="12.5" Padding="6,2" Margin="0,0,4,0"
                      Click="OnIssueClick" ToolTip.Tip="Open on GitHub" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>

      <Expander Classes="block" IsExpanded="True">
        <Expander.Header>
          <TextBlock Classes="sectiontitle" Text="Description" />
        </Expander.Header>
        <md:MarkdownScrollViewer x:Name="DescriptionView" Markdown="{Binding State.Description}" MaxHeight="240" />
      </Expander>

      <Expander Classes="block" IsExpanded="{Binding State.CommitsExpanded}" IsVisible="{Binding State.CommitsHeader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Expander.Header>
          <DockPanel>
            <TextBlock Classes="sectiontitle" Text="Commits" />
            <TextBlock Classes="sectiondetail" Text="{Binding State.CommitsHeader}" />
          </DockPanel>
        </Expander.Header>
        <StackPanel>
          <ListBox x:Name="CommitsList" ItemsSource="{Binding CommitLines}" DoubleTapped="OnCommitDoubleTapped"
                   ToolTip.Tip="Double-click opens the commit on GitHub">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="docs:CommitLine">
                <StackPanel Orientation="Horizontal" ToolTip.Tip="{Binding Message}">
                  <TextBlock Classes="mono" Opacity="0.7" Width="96" Margin="12,0,0,0"
                             Text="{Binding ShortSha}" FontWeight="{Binding Weight}" />
                  <TextBlock Classes="mono" Width="56" TextAlignment="Right" Foreground="#2EA043" Text="{Binding Added}" />
                  <TextBlock Classes="mono" Width="52" TextAlignment="Right" Foreground="#F85149" Text="{Binding Removed}" Margin="0,0,10,0" />
                  <TextBlock Classes="mono" Opacity="0.9" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Expander>

      <Expander Classes="block" IsExpanded="True" IsVisible="{Binding State.FilesHeader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Expander.Header>
          <DockPanel>
            <TextBlock Classes="sectiontitle" Text="Changed files" />
            <TextBlock Classes="sectiondetail" Text="{Binding State.FilesHeader}" />
          </DockPanel>
        </Expander.Header>
        <StackPanel>
          <ListBox x:Name="FilesList" ItemsSource="{Binding FileCosts}" DoubleTapped="OnFileDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="docs:FileCostRow">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="mono" Opacity="0.7" Width="50" Text="{Binding Marker}" />
                  <TextBlock Classes="mono" Width="56" TextAlignment="Right" Foreground="#2EA043" Text="{Binding Added}" />
                  <TextBlock Classes="mono" Width="52" TextAlignment="Right" Foreground="#F85149" Text="{Binding Removed}" />
                  <TextBlock Classes="mono" Width="78" TextAlignment="Right" Opacity="0.9" Text="{Binding Minutes}" Margin="0,0,8,0" />
                  <TextBlock Classes="mono" Width="62" Opacity="0.8" Text="{Binding Churn}" />
                  <TextBlock Classes="mono" Opacity="0.9" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Expander>

      <Expander Classes="block" IsExpanded="False">
        <Expander.Header>
          <DockPanel>
            <TextBlock Classes="sectiontitle" Text="Changed members" />
            <TextBlock Classes="sectiondetail" Text="{Binding State.MembersHeader}" />
          </DockPanel>
        </Expander.Header>
        <StackPanel>
          <ListBox x:Name="ImplList" ItemsSource="{Binding ImplMembers}" DoubleTapped="OnImplDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="docs:MemberRow">
                <TextBlock Classes="mono" Foreground="{Binding Foreground}"
                           Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ListBox x:Name="TestList" ItemsSource="{Binding TestGroups}" DoubleTapped="OnTestDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="docs:MemberRow">
                <TextBlock Classes="mono" Foreground="{Binding Foreground}"
                           Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Expander>

      <Expander Classes="block" IsExpanded="True">
        <Expander.Header>
          <DockPanel>
            <TextBlock Classes="sectiontitle" Text="Consequence sweep" />
            <TextBlock Classes="sectiondetail" Text="{Binding State.SweepHeader}" />
          </DockPanel>
        </Expander.Header>
        <StackPanel>
          <ListBox x:Name="SweepList" ItemsSource="{Binding SweepItems}" DoubleTapped="OnSweepDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock FontSize="13" Text="{Binding Title}" TextWrapping="Wrap" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
