<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="using:Stampeded.Editor"
             x:Class="Stampeded.Documents.SideBySideDocumentView">
  <Grid x:Name="Panes" ColumnDefinitions="*,4,*">
    <editor:ReviewTextEditor x:Name="Left" IsReadOnly="True" />
    <GridSplitter Grid.Column="1" />
    <editor:ReviewTextEditor x:Name="Right" Grid.Column="2" IsReadOnly="True" />
    <!-- One editor for both panes: which pane a comment is on is the caret's business, and
         two boxes would be two places to keep in step. -->
    <!-- Anchored in code to the pane the caret is in; a target named here would be one of
         the two, and the editor opens under whichever the comment is about. -->
    <Popup x:Name="CommentPopup" PlacementTarget="Left" Placement="AnchorAndGravity"
           PlacementAnchor="TopLeft" PlacementGravity="BottomRight" IsLightDismissEnabled="True">
      <Border Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="#3794FF"
              BorderThickness="1" CornerRadius="4" Padding="8" MinWidth="380" MaxWidth="560">
        <StackPanel Spacing="6">
          <TextBlock x:Name="CommentTargetText" FontSize="11" Opacity="0.7"
                     TextTrimming="CharacterEllipsis" />
          <TextBox x:Name="CommentBox" AcceptsReturn="True" MinHeight="56" MaxHeight="150"
                   TextWrapping="Wrap" FontSize="13"
                   TextChanged="OnCommentTextChanged" />
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <TextBlock FontSize="10" Opacity="0.6" VerticalAlignment="Center"
                       Text="Ctrl+Enter saves the draft, Esc closes" />
            <Button Content="Save draft" Click="OnCommentSave" FontWeight="SemiBold" />
            <Button Content="Cancel" Click="OnCommentCancel" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
