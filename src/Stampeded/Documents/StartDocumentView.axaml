<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Stampeded.Documents"
             xmlns:app="using:Stampeded"
             xmlns:controls="using:Stampeded.Controls"
             xmlns:gh="using:Stampeded.Core.GitHub"
             x:Class="Stampeded.Documents.StartDocumentView"
             x:DataType="docs:StartDocumentViewModel"
             FontSize="14">
  <UserControl.Styles>
    <Style Selector="TextBlock.colhead">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- The branch/stash options double as that column's header, so they carry the
         header's weight and keep its row height: the three lists must stay aligned. -->
    <Style Selector="RadioButton.colhead">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="4,0,0,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Per-row shortcuts for the common actions, revealed on the hovered or selected row
         only: these lists run to dozens of entries. They sit inboard of the always-visible
         status, so claiming their space only re-trims the title on the one row and never
         changes its height. The context menu stays the full set. -->
    <Style Selector="StackPanel.rowactions">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBoxItem:pointerover StackPanel.rowactions">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ListBoxItem:selected StackPanel.rowactions">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- One height for all three column headers, whatever each one holds: they are what the
         three lists start below, so a header that sizes itself to its own content puts its
         list out of line with the other two. -->
    <Style Selector="Grid.header">
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <!-- The title side of a header is held to what is left over: a title, or a pair of them,
         that outgrows a narrow column is cut off rather than drawn across the buttons. -->
    <Style Selector="Panel.headtitle">
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Grid.Column" Value="0" />
    </Style>
    <!-- A filter box takes over its column's header while it is open, rather than sitting on a
         row of its own or squeezing in beside the title: three columns this narrow have room
         for one or the other, and a row of three empty boxes costs list space for nothing. -->
    <Style Selector="TextBox.filter">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.headbutton">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.rowactions > Button">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The icons of a row action sit in a line of text, so they take its size rather than a
         toolbar's. -->
    <Style Selector="StackPanel.rowactions Image">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="1*,8,2*,8,2*" Margin="8">
    <DockPanel Grid.Column="0">
      <Grid DockPanel.Dock="Top" Classes="header" ColumnDefinitions="*,Auto">
        <Panel Classes="headtitle">
          <TextBlock Classes="colhead" Margin="0" Text="Repositories" />
          <TextBox x:Name="RecentFilterBox" Classes="filter" KeyDown="OnFilterKeyDown" PlaceholderText="Filter repositories"
                   Text="{Binding State.RecentFilter}"
                   IsVisible="{Binding #RecentFilterToggle.IsChecked}" />
        </Panel>
        <ToggleButton Grid.Column="1" x:Name="RecentFilterToggle" Classes="tool"
                      IsCheckedChanged="OnFilterToggled"
                      ToolTip.Tip="Filter (Ctrl+F, or just start typing in the list) - show only the repositories whose path contains every word typed">
          <Image Source="{x:Static app:Images.Filter}" />
        </ToggleButton>
      </Grid>
      <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,4,0,0">
        <Button HorizontalAlignment="Stretch" Click="OnOpenRepository">
          <DockPanel>
            <Image DockPanel.Dock="Left" Source="{x:Static app:Images.OpenFolder}" Width="16" Height="16"
                   Margin="0,0,6,0" />
            <TextBlock Text="Open Repository..." />
          </DockPanel>
        </Button>
        <Button HorizontalAlignment="Stretch" Click="OnOpenFromUrl">
          <DockPanel>
            <Image DockPanel.Dock="Left" Source="{x:Static app:Images.OpenWebSite}" Width="16" Height="16"
                   Margin="0,0,6,0" />
            <TextBlock Text="Open from URL..." />
          </DockPanel>
        </Button>
      </StackPanel>
      <ListBox x:Name="RecentList" ItemsSource="{Binding Recents}" DoubleTapped="OnRecentDoubleTapped"
               TextInput="OnListTextInput" KeyDown="OnListKeyDown"
               FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
    </DockPanel>
    <DockPanel Grid.Column="2">
      <Grid DockPanel.Dock="Top" Classes="header" ColumnDefinitions="*,Auto">
        <Panel Classes="headtitle">
          <TextBlock Classes="colhead" Margin="0" Text="{Binding State.PrColumnHeader}" />
          <TextBox x:Name="PrFilterBox" Classes="filter" KeyDown="OnFilterKeyDown" PlaceholderText="Filter pull requests"
                   Text="{Binding State.PrFilter}"
                   IsVisible="{Binding #PrFilterToggle.IsChecked}" />
        </Panel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ToggleButton x:Name="PrFilterToggle" Classes="tool" IsCheckedChanged="OnFilterToggled"
                        ToolTip.Tip="Filter (Ctrl+F, or just start typing in the list) - show only the pull requests matching every word typed, by number, title, author, head branch or target branch">
            <Image Source="{x:Static app:Images.Filter}" />
          </ToggleButton>
          <Button Classes="tool" Click="OnPrRefresh"
                  ToolTip.Tip="Refresh - re-read the open pull requests from GitHub">
            <Image Source="{x:Static app:Images.Refresh}" />
          </Button>
        </StackPanel>
      </Grid>
      <!-- An empty list is an answer only when it says which one: no pull requests, or no
           GitHub to ask. -->
      <TextBlock DockPanel.Dock="Bottom" Margin="2,4,0,0" FontSize="12" Opacity="0.75"
                 TextWrapping="Wrap" Text="{Binding PrList.State.Status}"
                 IsVisible="{Binding !PrList.Items.Count}" />
      <!-- Loading says so inside the list, which is the thing that is empty. In the header it
           shared a row with the buttons and lost. -->
      <Panel>
      <ListBox x:Name="PrListBox" ItemsSource="{Binding Prs}" DoubleTapped="OnPrDoubleTapped"
               TextInput="OnListTextInput" KeyDown="OnListKeyDown"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open Review (double-click)" Click="OnPrOpen" />
            <MenuItem Header="Open on GitHub" Click="OnPrOpenOnGitHub" />
            <MenuItem Header="Pull Head Branch from origin" Click="OnPrPull" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.Styles>
          <Style Selector="StackPanel.draftpr">
            <Setter Property="Opacity" Value="0.55" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="gh:PrSummary">
            <StackPanel Margin="2" Classes.draftpr="{Binding IsDraft}">
              <DockPanel>
                <Panel DockPanel.Dock="Left" Width="14" VerticalAlignment="Center"
                       ToolTip.Tip="CI: green / in progress / failing">
                  <TextBlock Text="●" Foreground="#2EA043" IsVisible="{Binding ChecksGreen}" />
                  <TextBlock Text="●" Foreground="#D29922" IsVisible="{Binding ChecksPending}" />
                  <TextBlock Text="●" Foreground="#F85149" IsVisible="{Binding ChecksFailed}" />
                </Panel>
                <TextBlock DockPanel.Dock="Right" Text="draft" FontSize="11" Opacity="0.8"
                           VerticalAlignment="Center" IsVisible="{Binding IsDraft}" />
                <TextBlock DockPanel.Dock="Right" Text="approved" FontSize="11" Margin="6,0,6,0"
                           Foreground="#2EA043" VerticalAlignment="Center" IsVisible="{Binding IsApproved}"
                           ToolTip.Tip="A review has approved this pull request" />
                <TextBlock DockPanel.Dock="Right" Text="changes requested" FontSize="11" Margin="6,0,6,0"
                           Foreground="#F85149" VerticalAlignment="Center" IsVisible="{Binding ChangesRequested}"
                           ToolTip.Tip="A review has requested changes on this pull request" />
                <StackPanel DockPanel.Dock="Right" Classes="rowactions" Orientation="Horizontal"
                            Spacing="4" Margin="6,0">
                  <Button Content="Review" FontWeight="SemiBold" Click="OnRowPrReview"
                          ToolTip.Tip="Open this pull request for review" />
                  <Button Classes="tool" Click="OnRowPrPull"
                          ToolTip.Tip="Pull - bring this PR's head branch into the local repository: created if it is not there yet, fast-forwarded if it is behind. Nothing is checked out.">
                    <Image Source="{x:Static app:Images.Pull}" />
                  </Button>
                  <Button Classes="tool" Click="OnRowPrGitHub"
                          ToolTip.Tip="Open this pull request in the browser">
                    <Image Source="{x:Static app:Images.GitHub}" />
                  </Button>
                </StackPanel>
                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding NumberDisplay}" /> <Run Text="{Binding Title}" />
                </TextBlock>
              </DockPanel>
              <DockPanel Margin="14,0,0,0">
                <!-- Added and removed lines, right-aligned in a fixed slot so the columns line
                     up down the list rather than shifting with the size of the numbers. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                            Margin="8,0,0,0" ToolTip.Tip="{Binding StatsTip}">
                  <TextBlock FontSize="12" Foreground="#2EA043" MinWidth="40" TextAlignment="Right"
                             Text="{Binding AddedDisplay}" />
                  <TextBlock FontSize="12" Foreground="#F85149" MinWidth="34" TextAlignment="Right"
                             Text="{Binding RemovedDisplay}" />
                </StackPanel>
                <!-- Head and target read as one "source -> target", so they sit in a single
                     run with nothing between them. The author trails them rather than leading:
                     trimming takes the tail, and of the three it is the one a reader scanning
                     this column can most afford to lose. -->
                <TextBlock Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding BranchesTip}">
                  <Run Text="{Binding HeadRefName}" /><InlineUIContainer BaselineAlignment="Center">
                    <!-- Drawn rather than written: the UI font has no arrow, and the one the
                         fallback font supplies renders small and sits off the line. -->
                    <Path Data="M1,5 H12 M8.5,1.5 L12,5 L8.5,8.5" Stroke="{Binding $parent[TextBlock].Foreground}"
                          StrokeThickness="1.2" Width="13" Height="10" Margin="5,0" />
                  </InlineUIContainer><Run Text="{Binding BaseRefName}" /> · <Run Text="{Binding Author.Login}" />
                </TextBlock>
              </DockPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
        <!-- Over the list, near its top: the first rows are where a reader is looking, and
             one that fills in underneath keeps its place. -->
        <StackPanel IsVisible="{Binding PrList.State.Loading}" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Spacing="8">
          <controls:WaveSpinner SquareSize="4" Width="60" HorizontalAlignment="Center" />
          <TextBlock Text="Reading the open pull requests from GitHub..." FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
        </StackPanel>
      </Panel>
    </DockPanel>
    <DockPanel Grid.Column="4">
      <TextBlock DockPanel.Dock="Bottom" Margin="2,4,0,0" FontSize="12" Opacity="0.75"
                 TextWrapping="Wrap" Text="{Binding State.RefsStatus}"
                 IsVisible="{Binding State.RefsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Grid DockPanel.Dock="Top" Classes="header" ColumnDefinitions="*,Auto">
        <Panel Classes="headtitle">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <RadioButton x:Name="BranchesMode" Classes="colhead" GroupName="RefKind"
                         Content="{Binding State.BranchesLabel}"
                         IsChecked="True" IsCheckedChanged="OnRefKindChanged" />
            <RadioButton x:Name="StashesMode" Classes="colhead" GroupName="RefKind"
                         Content="{Binding State.StashesLabel}"
                         IsCheckedChanged="OnRefKindChanged"
                         ToolTip.Tip="Review a stash as the diff between the commit it was taken on and the stashed state" />
          </StackPanel>
          <TextBox x:Name="BranchFilterBox" Classes="filter" KeyDown="OnFilterKeyDown" PlaceholderText="Filter branches"
                   Text="{Binding State.BranchFilter}"
                   IsVisible="{Binding #BranchFilterToggle.IsChecked}" />
        </Panel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ToggleButton x:Name="BranchFilterToggle" Classes="tool" IsCheckedChanged="OnFilterToggled"
                        ToolTip.Tip="Filter (Ctrl+F, or just start typing in the list) - show only the branches or stashes matching every word typed, by name, commit subject or pull request number">
            <Image Source="{x:Static app:Images.Filter}" />
          </ToggleButton>
          <Button Classes="tool" Click="OnFetch"
                  ToolTip.Tip="Fetch - git fetch origin: update the remote-tracking refs, then re-read both lists. Branches whose sync state reads 'differs' need this before it can be measured.">
            <Image Source="{x:Static app:Images.Fetch}" />
          </Button>
          <Button Classes="tool" Click="OnRefsRefresh"
                  ToolTip.Tip="Refresh - re-read branches and stashes from the repository">
            <Image Source="{x:Static app:Images.Refresh}" />
          </Button>
        </StackPanel>
      </Grid>
      <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                 Text="{Binding State.Status}"
                 IsVisible="{Binding State.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Panel>
      <ListBox x:Name="BranchList" ItemsSource="{Binding Branches}" DoubleTapped="OnBranchDoubleTapped"
               TextInput="OnListTextInput" KeyDown="OnListKeyDown"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open Review (double-click)" Click="OnBranchOpen" />
            <MenuItem Header="Copy Branch Name" Click="OnCopyBranchName"
                      IsVisible="{Binding !State.ShowStashes}" />
            <MenuItem Header="Create Branch from Stash..." Click="OnCreateBranchFromStash"
                      IsVisible="{Binding State.ShowStashes}" />
            <MenuItem Header="Pull from origin" Click="OnPullBranch"
                      IsVisible="{Binding !State.ShowStashes}"
                      ToolTip.Tip="Fast-forward this branch to origin's copy; a diverged branch is left alone" />
            <MenuItem Header="Open Worktree" Click="OnOpenWorktree"
                      IsVisible="{Binding !State.ShowStashes}"
                      ToolTip.Tip="Open the checkout that has this branch in the file manager" />
            <MenuItem Header="Delete Merged Branch" Click="OnDeleteBranch"
                      IsVisible="{Binding !State.ShowStashes}"
                      ToolTip.Tip="Delete this local branch, if it is already in the default branch" />
            <MenuItem Header="Push to origin" Click="OnPushBranch"
                      IsVisible="{Binding !State.ShowStashes}"
                      ToolTip.Tip="Push to origin, force-pushing with --force-with-lease when the branches have diverged" />
            <MenuItem Header="Rebase onto Default Base" Click="OnRebaseBranch"
                      IsVisible="{Binding !State.ShowStashes}"
                      ToolTip.Tip="Rebase this branch onto the default base. A branch no checkout has is rebased in a throwaway worktree; one that a checkout has is rebased there, so that checkout moves with it" />
            <MenuItem Header="Rebase PR onto its Target (server-side)" Click="OnRebasePr"
                      IsVisible="{Binding !State.ShowStashes}" />
            <MenuItem Header="Open PR on GitHub" Click="OnBranchPrOnGitHub"
                      IsVisible="{Binding !State.ShowStashes}" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="docs:BranchRow">
            <StackPanel Margin="2">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" IsVisible="{Binding HasSync}"
                            ToolTip.Tip="{Binding SyncTip}">
                  <TextBlock Text="●" FontSize="11" VerticalAlignment="Center"
                             Foreground="{Binding SyncBrush}" />
                  <TextBlock Text="{Binding SyncText}" FontSize="11" VerticalAlignment="Center"
                             Foreground="{Binding SyncBrush}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" FontSize="11" Opacity="0.8" VerticalAlignment="Center"
                           Margin="0,0,6,0" Foreground="#3794FF" Text="{Binding PrTag}"
                           IsVisible="{Binding HasPrTag}"
                           ToolTip.Tip="This branch has an open pull request" />
                <TextBlock DockPanel.Dock="Right" FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                           Margin="0,0,6,0" Text="{Binding CommitsText}" IsVisible="{Binding HasCommits}"
                           ToolTip.Tip="Commits this branch has that the default base does not - what reviewing it would mean reading" />
                <!-- Integration state: whether the branch is already in the default branch,
                     and which branch the default one is. -->
                <TextBlock DockPanel.Dock="Right" FontSize="11" Opacity="0.9" VerticalAlignment="Center"
                           Margin="0,0,6,0" Foreground="#2EA043" Text="{Binding MergeText}"
                           IsVisible="{Binding ShowMerge}" ToolTip.Tip="{Binding MergeTip}" />
                <TextBlock DockPanel.Dock="Right" FontSize="11" Opacity="0.8" VerticalAlignment="Center"
                           Margin="0,0,6,0" Foreground="#8B949E" Text="default"
                           IsVisible="{Binding ShowDefault}"
                           ToolTip.Tip="The repository's default branch on GitHub, and what everything else is reviewed and rebased against" />
                <StackPanel DockPanel.Dock="Right" Classes="rowactions" Orientation="Horizontal"
                            Spacing="4" Margin="6,0">
                  <Button Content="Review" FontWeight="SemiBold" Click="OnRowBranchReview"
                          ToolTip.Tip="Open this for review" />
                  <Button Classes="tool" Click="OnRowBranchPull" IsVisible="{Binding IsBranch}"
                          ToolTip.Tip="Pull - fast-forward this branch to origin's copy; a diverged branch is left alone">
                    <Image Source="{x:Static app:Images.Pull}" />
                  </Button>
                  <Button Classes="tool" Click="OnRowBranchWorktree" IsVisible="{Binding HasWorktree}"
                          ToolTip.Tip="{Binding WorktreePath}">
                    <Image Source="{x:Static app:Images.FolderOpened}" />
                  </Button>
                  <!-- Only for a branch already in the default branch, so it can never be
                       the button that loses work. -->
                  <Button Classes="tool" Click="OnRowBranchDelete" IsVisible="{Binding ShowMerge}"
                          ToolTip.Tip="Delete this local branch, and the worktree holding it if there is one. It is already in the default branch, and the commit it points at is reported so it can be put back. A worktree with uncommitted or untracked files stops the whole thing.">
                    <Image Source="{x:Static app:Images.Delete}" />
                  </Button>
                  <Button Classes="tool" Click="OnRowBranchPush" IsVisible="{Binding IsBranch}"
                          ToolTip.Tip="Push this branch to origin. Diverged branches - what a rebase leaves - are force-pushed with --force-with-lease, which still refuses if origin moved since the last fetch.">
                    <Image Source="{x:Static app:Images.Push}" />
                  </Button>
                  <Button Classes="tool" Click="OnRowBranchRebase" IsVisible="{Binding IsBranch}"
                          ToolTip.Tip="Rebase onto the default base. A branch no checkout has is rebased in a throwaway worktree; one that a checkout has is rebased there, so that checkout moves with it">
                    <Image Source="{x:Static app:Images.Rebase}" />
                  </Button>
                  <Button Classes="tool" Click="OnRowStashBranch" IsVisible="{Binding IsStash}"
                          ToolTip.Tip="Branch - point a new branch at this stash; the stash is kept and nothing is checked out">
                    <Image Source="{x:Static app:Images.Branch}" />
                  </Button>
                  <Button Classes="tool" Click="OnRowBranchPrGitHub" IsVisible="{Binding HasPrTag}"
                          ToolTip.Tip="Open this branch's pull request in the browser">
                    <Image Source="{x:Static app:Images.GitHub}" />
                  </Button>
                </StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{Binding Info.Name}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <TextBlock Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Info.Date}" /> · <Run Text="{Binding Info.Subject}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
        <!-- Over the list, near its top: the first rows are where a reader is looking, and
             one that fills in underneath keeps its place. -->
        <StackPanel IsVisible="{Binding State.RefsLoading}" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Spacing="8">
          <controls:WaveSpinner SquareSize="4" Width="60" HorizontalAlignment="Center" />
          <TextBlock Text="Reading branches and stashes..." FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
        </StackPanel>
      </Panel>
    </DockPanel>
  </Grid>
</UserControl>
