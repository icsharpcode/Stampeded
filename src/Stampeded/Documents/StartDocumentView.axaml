<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Stampeded.Documents"
             xmlns:gh="using:Stampeded.Core.GitHub"
             x:Class="Stampeded.Documents.StartDocumentView"
             x:DataType="docs:StartDocumentViewModel"
             FontSize="14">
  <UserControl.Styles>
    <Style Selector="TextBlock.colhead">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The branch/stash options double as that column's header, so they carry the
         header's weight and keep its row height: the three lists must stay aligned. -->
    <Style Selector="RadioButton.colhead">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="4,0,0,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Per-row shortcuts for the common actions, revealed on the hovered or selected row
         only: these lists run to dozens of entries. They sit inboard of the always-visible
         status, so claiming their space only re-trims the title on the one row and never
         changes its height. The context menu stays the full set. -->
    <Style Selector="StackPanel.rowactions">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBoxItem:pointerover StackPanel.rowactions">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ListBoxItem:selected StackPanel.rowactions">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.headbutton">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.rowactions > Button">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="1*,8,2*,8,2*" Margin="8">
    <DockPanel Grid.Column="0">
      <TextBlock DockPanel.Dock="Top" Classes="colhead" Text="Repositories" />
      <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,4,0,0">
        <Button Content="Open Repository..." HorizontalAlignment="Stretch" Click="OnOpenRepository" />
        <Button Content="Open from URL..." HorizontalAlignment="Stretch" Click="OnOpenFromUrl" />
      </StackPanel>
      <ListBox x:Name="RecentList" ItemsSource="{Binding Recents}" DoubleTapped="OnRecentDoubleTapped"
               FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
    </DockPanel>
    <DockPanel Grid.Column="2">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
        <Button DockPanel.Dock="Right" Classes="headbutton" Content="Refresh" Click="OnPrRefresh"
                ToolTip.Tip="Re-read the open pull requests from GitHub" />
        <TextBlock Classes="colhead" Margin="0" Text="{Binding State.PrColumnHeader}" />
      </DockPanel>
      <ListBox x:Name="PrListBox" ItemsSource="{Binding PrList.Items}" DoubleTapped="OnPrDoubleTapped"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open Review (double-click)" Click="OnPrOpen" />
            <MenuItem Header="Open on GitHub" Click="OnPrOpenOnGitHub" />
            <MenuItem Header="Pull Head Branch from origin" Click="OnPrPull" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.Styles>
          <Style Selector="StackPanel.draftpr">
            <Setter Property="Opacity" Value="0.55" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="gh:PrSummary">
            <StackPanel Margin="2" Classes.draftpr="{Binding IsDraft}">
              <DockPanel>
                <Panel DockPanel.Dock="Left" Width="14" VerticalAlignment="Center"
                       ToolTip.Tip="CI: green / in progress / failing">
                  <TextBlock Text="●" Foreground="#2EA043" IsVisible="{Binding ChecksGreen}" />
                  <TextBlock Text="●" Foreground="#D29922" IsVisible="{Binding ChecksPending}" />
                  <TextBlock Text="●" Foreground="#F85149" IsVisible="{Binding ChecksFailed}" />
                </Panel>
                <TextBlock DockPanel.Dock="Right" Text="draft" FontSize="11" Opacity="0.8"
                           VerticalAlignment="Center" IsVisible="{Binding IsDraft}" />
                <TextBlock DockPanel.Dock="Right" Text="approved" FontSize="11" Margin="6,0,0,0"
                           Foreground="#2EA043" VerticalAlignment="Center" IsVisible="{Binding IsApproved}"
                           ToolTip.Tip="A review has approved this pull request" />
                <TextBlock DockPanel.Dock="Right" Text="changes requested" FontSize="11" Margin="6,0,0,0"
                           Foreground="#F85149" VerticalAlignment="Center" IsVisible="{Binding ChangesRequested}"
                           ToolTip.Tip="A review has requested changes on this pull request" />
                <StackPanel DockPanel.Dock="Right" Classes="rowactions" Orientation="Horizontal"
                            Spacing="4" Margin="6,0">
                  <Button Content="Review" FontWeight="SemiBold" Click="OnRowPrReview"
                          ToolTip.Tip="Open this pull request for review" />
                  <Button Content="Pull" Click="OnRowPrPull"
                          ToolTip.Tip="Bring this PR's head branch into the local repository: created if it is not there yet, fast-forwarded if it is behind. Nothing is checked out." />
                  <Button Content="GitHub" Click="OnRowPrGitHub" ToolTip.Tip="Open this pull request in the browser" />
                </StackPanel>
                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding NumberDisplay}" /> <Run Text="{Binding Title}" />
                </TextBlock>
              </DockPanel>
              <TextBlock Opacity="0.6" FontSize="12" Margin="14,0,0,0">
                <Run Text="{Binding Author.Login}" /> · <Run Text="{Binding HeadRefName}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <DockPanel Grid.Column="4">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
        <Button DockPanel.Dock="Right" Classes="headbutton" Content="Refresh" Click="OnRefsRefresh"
                ToolTip.Tip="Re-read branches and stashes from the repository" />
        <Button DockPanel.Dock="Right" Classes="headbutton" Content="Fetch" Click="OnFetch"
                ToolTip.Tip="git fetch origin: update the remote-tracking refs, then re-read both lists. Branches whose sync state reads 'differs' need this before it can be measured." />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <RadioButton x:Name="BranchesMode" Classes="colhead" GroupName="RefKind"
                       Content="{Binding State.BranchesLabel}"
                       IsChecked="True" IsCheckedChanged="OnRefKindChanged" />
          <RadioButton x:Name="StashesMode" Classes="colhead" GroupName="RefKind"
                       Content="{Binding State.StashesLabel}"
                       IsCheckedChanged="OnRefKindChanged"
                       ToolTip.Tip="Review a stash as the diff between the commit it was taken on and the stashed state" />
        </StackPanel>
      </DockPanel>
      <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                 Text="{Binding State.Status}"
                 IsVisible="{Binding State.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ListBox x:Name="BranchList" ItemsSource="{Binding Branches}" DoubleTapped="OnBranchDoubleTapped"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open Review (double-click)" Click="OnBranchOpen" />
            <MenuItem Header="Copy Branch Name" Click="OnCopyBranchName"
                      IsVisible="{Binding !State.ShowStashes}" />
            <MenuItem Header="Create Branch from Stash..." Click="OnCreateBranchFromStash"
                      IsVisible="{Binding State.ShowStashes}" />
            <MenuItem Header="Pull from origin" Click="OnPullBranch"
                      IsVisible="{Binding !State.ShowStashes}"
                      ToolTip.Tip="Fast-forward this branch to origin's copy; a diverged branch is left alone" />
            <MenuItem Header="Open Worktree" Click="OnOpenWorktree"
                      IsVisible="{Binding !State.ShowStashes}"
                      ToolTip.Tip="Open the checkout that has this branch in the file manager" />
            <MenuItem Header="Delete Merged Branch" Click="OnDeleteBranch"
                      IsVisible="{Binding !State.ShowStashes}"
                      ToolTip.Tip="Delete this local branch, if it is already in the default branch" />
            <MenuItem Header="Push to origin" Click="OnPushBranch"
                      IsVisible="{Binding !State.ShowStashes}"
                      ToolTip.Tip="Push to origin, force-pushing with --force-with-lease when the branches have diverged" />
            <MenuItem Header="Rebase onto Default Base" Click="OnRebaseBranch"
                      IsVisible="{Binding !State.ShowStashes}"
                      ToolTip.Tip="Rebase this branch onto the default base. A branch no checkout has is rebased in a throwaway worktree; one that a checkout has is rebased there, so that checkout moves with it" />
            <MenuItem Header="Rebase PR onto its Target (server-side)" Click="OnRebasePr"
                      IsVisible="{Binding !State.ShowStashes}" />
            <MenuItem Header="Open PR on GitHub" Click="OnBranchPrOnGitHub"
                      IsVisible="{Binding !State.ShowStashes}" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="docs:BranchRow">
            <StackPanel Margin="2">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" IsVisible="{Binding HasSync}"
                            ToolTip.Tip="{Binding SyncTip}">
                  <TextBlock Text="●" FontSize="11" VerticalAlignment="Center"
                             Foreground="{Binding SyncBrush}" />
                  <TextBlock Text="{Binding SyncText}" FontSize="11" VerticalAlignment="Center"
                             Foreground="{Binding SyncBrush}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" FontSize="11" Opacity="0.8" VerticalAlignment="Center"
                           Margin="0,0,6,0" Foreground="#3794FF" Text="{Binding PrTag}"
                           IsVisible="{Binding HasPrTag}"
                           ToolTip.Tip="This branch has an open pull request" />
                <!-- Integration state: whether the branch is already in the default branch,
                     and which branch the default one is. -->
                <TextBlock DockPanel.Dock="Right" FontSize="11" Opacity="0.9" VerticalAlignment="Center"
                           Margin="0,0,6,0" Foreground="#2EA043" Text="{Binding MergeText}"
                           IsVisible="{Binding ShowMerge}" ToolTip.Tip="{Binding MergeTip}" />
                <TextBlock DockPanel.Dock="Right" FontSize="11" Opacity="0.8" VerticalAlignment="Center"
                           Margin="0,0,6,0" Foreground="#8B949E" Text="default"
                           IsVisible="{Binding ShowDefault}"
                           ToolTip.Tip="The repository's default branch on GitHub, and what everything else is reviewed and rebased against" />
                <StackPanel DockPanel.Dock="Right" Classes="rowactions" Orientation="Horizontal"
                            Spacing="4" Margin="6,0">
                  <Button Content="Review" FontWeight="SemiBold" Click="OnRowBranchReview"
                          ToolTip.Tip="Open this for review" />
                  <Button Content="Pull" Click="OnRowBranchPull" IsVisible="{Binding IsBranch}"
                          ToolTip.Tip="Fast-forward this branch to origin's copy; a diverged branch is left alone" />
                  <Button Content="Worktree" Click="OnRowBranchWorktree" IsVisible="{Binding HasWorktree}"
                          ToolTip.Tip="{Binding WorktreePath}" />
                  <!-- Only for a branch already in the default branch, so it can never be
                       the button that loses work. -->
                  <Button Content="Delete" Click="OnRowBranchDelete" IsVisible="{Binding ShowMerge}"
                          ToolTip.Tip="Delete this local branch, and the worktree holding it if there is one. It is already in the default branch, and the commit it points at is reported so it can be put back. A worktree with uncommitted or untracked files stops the whole thing." />
                  <Button Content="Push" Click="OnRowBranchPush" IsVisible="{Binding IsBranch}"
                          ToolTip.Tip="Push this branch to origin. Diverged branches - what a rebase leaves - are force-pushed with --force-with-lease, which still refuses if origin moved since the last fetch." />
                  <Button Content="Rebase" Click="OnRowBranchRebase" IsVisible="{Binding IsBranch}"
                          ToolTip.Tip="Rebase onto the default base. A branch no checkout has is rebased in a throwaway worktree; one that a checkout has is rebased there, so that checkout moves with it" />
                  <Button Content="Branch..." Click="OnRowStashBranch" IsVisible="{Binding IsStash}"
                          ToolTip.Tip="Point a new branch at this stash; the stash is kept and nothing is checked out" />
                  <Button Content="PR" Click="OnRowBranchPrGitHub" IsVisible="{Binding HasPrTag}"
                          ToolTip.Tip="Open this branch's pull request in the browser" />
                </StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{Binding Info.Name}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <TextBlock Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Info.Date}" /> · <Run Text="{Binding Info.Subject}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
