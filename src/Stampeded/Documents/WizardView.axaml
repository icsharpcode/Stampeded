<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Stampeded.Documents"
             xmlns:panes="using:Stampeded.Panes"
             xmlns:gh="using:Stampeded.Core.GitHub"
             xmlns:git="using:Stampeded.Core.Git"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             x:Class="Stampeded.Documents.WizardView"
             x:DataType="docs:WizardViewModel">
  <UserControl.Styles>
    <Style Selector="Button.step">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Margin" Value="1,0" />
    </Style>
    <Style Selector="Button.step.done">
      <Setter Property="BorderBrush" Value="#2EA043" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="Background" Value="#182EA043" />
    </Style>
    <Style Selector="Button.step.current">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="BorderBrush" Value="#3794FF" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="TextBlock.colhead">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="8">
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Steps}" Margin="0,0,0,6"
                  IsVisible="{Binding !State.HasReview}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="docs:WizardStep">
          <Button Classes="step" Classes.current="{Binding IsCurrent}" Classes.done="{Binding IsSatisfied}" Click="OnStepClick">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding Title}" />
              <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#2EA043"
                         VerticalAlignment="Center" IsVisible="{Binding IsSatisfied}" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button Content="Back" Click="OnBack" />
      <Button Content="Next" Click="OnNext" FontWeight="SemiBold"
              ToolTip.Tip="Mark this phase done and advance" />
      <Button Content="Skip" Click="OnSkip"
              ToolTip.Tip="Advance without marking the phase done" />
      <Button Content="Bounce..." Click="OnBounce" IsVisible="{Binding TriageStep.IsCurrent}"
              ToolTip.Tip="Draft a decline-with-reason review comment" />
      <Button Content="Review record" Click="OnRecord" IsVisible="{Binding CloseStep.IsCurrent}"
              ToolTip.Tip="Write the close-out artifact" />
      <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding State.Progress}" />
      <CheckBox IsChecked="{Binding State.OverrideGate}" FontSize="11"
                Content="Allow approving anyway (override)" />
    </StackPanel>

    <DockPanel>
      <!-- Uniform step header: guidance, computed facts, done-check. -->
      <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Steps}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="docs:WizardStep">
            <Border Padding="8,6" Margin="0,0,0,6" CornerRadius="3" BorderThickness="1"
                    BorderBrush="#40808080" IsVisible="{Binding IsCurrent}">
              <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding Title}" />
                <TextBlock FontSize="12" Opacity="0.75" TextWrapping="Wrap" Text="{Binding Guidance}" />
                <TextBlock FontSize="12" FontStyle="Italic" Opacity="0.9" TextWrapping="Wrap"
                           Text="{Binding Facts}"
                           IsVisible="{Binding Facts, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Panel>
      <!-- Prep: live workspace-preparation checklist. -->
      <StackPanel IsVisible="{Binding PrepareStep.IsCurrent}" Spacing="4" MaxWidth="560"
                  HorizontalAlignment="Left">
        <ItemsControl ItemsSource="{Binding PrepareItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="docs:PrepareItem">
              <DockPanel Margin="2,3">
                <Panel DockPanel.Dock="Left" Width="22">
                  <TextBlock Text="✓" FontWeight="Bold" Foreground="#2EA043" IsVisible="{Binding Done}" />
                  <TextBlock Text="..." Opacity="0.6" IsVisible="{Binding !Done}" />
                </Panel>
                <TextBlock DockPanel.Dock="Right" Opacity="0.7" FontSize="12" Text="{Binding Status}" />
                <TextBlock Text="{Binding Label}" FontSize="13" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Continue now" Click="OnContinueFromPrepare" Margin="22,6,0,0"
                ToolTip.Tip="Go to Triage without waiting; loading continues in the background" />
      </StackPanel>

      <!-- Assess: intent (description), then commits and per-file cost as compact blocks. -->
      <DockPanel IsVisible="{Binding TriageStep.IsCurrent}">
        <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="8,4" CornerRadius="3"
                BorderThickness="1" BorderBrush="#40808080"
                IsVisible="{Binding State.FilesHeader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                ToolTip.Tip="Category, delta, weighted minutes, churn (commits/year) per file">
          <StackPanel>
            <TextBlock FontSize="11" FontFamily="monospace" Opacity="0.85" Text="{Binding State.FilesHeader}" />
            <ItemsControl ItemsSource="{Binding FileCosts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="docs:FileCostRow">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="11" FontFamily="monospace" Opacity="0.7" Width="44" Text="{Binding Marker}" Margin="12,0,0,0" />
                    <TextBlock FontSize="11" FontFamily="monospace" Width="50" TextAlignment="Right" Foreground="#2EA043" Text="{Binding Added}" />
                    <TextBlock FontSize="11" FontFamily="monospace" Width="46" TextAlignment="Right" Foreground="#F85149" Text="{Binding Removed}" />
                    <TextBlock FontSize="11" FontFamily="monospace" Width="70" TextAlignment="Right" Opacity="0.9" Text="{Binding Minutes}" Margin="0,0,8,0" />
                    <TextBlock FontSize="11" FontFamily="monospace" Width="56" Opacity="0.8" Text="{Binding Churn}" />
                    <TextBlock FontSize="11" FontFamily="monospace" Opacity="0.85" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="8,4" CornerRadius="3"
                BorderThickness="1" BorderBrush="#40808080"
                IsVisible="{Binding State.CommitsHeader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                ToolTip.Tip="The Commits pane (bottom dock) has per-commit file diffs">
          <StackPanel>
            <TextBlock FontSize="11" FontFamily="monospace" Opacity="0.85" Text="{Binding State.CommitsHeader}" />
            <ItemsControl ItemsSource="{Binding CommitLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="docs:CommitLine">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="11" FontFamily="monospace" Opacity="0.7" Width="86" Text="{Binding ShortSha}" Margin="12,0,0,0" />
                    <TextBlock FontSize="11" FontFamily="monospace" Width="50" TextAlignment="Right" Foreground="#2EA043" Text="{Binding Added}" />
                    <TextBlock FontSize="11" FontFamily="monospace" Width="46" TextAlignment="Right" Foreground="#F85149" Text="{Binding Removed}" Margin="0,0,10,0" />
                    <TextBlock FontSize="11" FontFamily="monospace" Opacity="0.85" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border BorderThickness="1" BorderBrush="#40808080" CornerRadius="3" Padding="8">
          <md:MarkdownScrollViewer Markdown="{Binding State.Description}" />
        </Border>
      </DockPanel>

      <!-- Start page: repositories | pull requests | branches. -->
      <Grid ColumnDefinitions="1*,4,2*,4,2*" IsVisible="{Binding SelectStep.IsCurrent}">
        <DockPanel Grid.Column="0">
          <TextBlock DockPanel.Dock="Top" Classes="colhead" Text="Repositories" />
          <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,4,0,0">
            <Button Content="Open Repository..." HorizontalAlignment="Stretch" Click="OnOpenRepository" />
            <Button Content="Open from URL..." HorizontalAlignment="Stretch" Click="OnOpenFromUrl" />
          </StackPanel>
          <ListBox x:Name="RecentList" ItemsSource="{Binding Recents}" DoubleTapped="OnRecentDoubleTapped"
                   FontSize="12" />
        </DockPanel>
        <DockPanel Grid.Column="2" Margin="6,0,0,0">
          <TextBlock DockPanel.Dock="Top" Classes="colhead" Text="{Binding State.PrColumnHeader}" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
            <Button Content="Open Guided" Click="OnPrOpenGuided" FontWeight="SemiBold" />
            <Button Content="Open Plain" Click="OnPrOpenPlain" />
            <Button Content="Refresh" Click="OnPrRefresh" />
          </StackPanel>
          <ListBox x:Name="PrListBox" ItemsSource="{Binding PrList.Items}" DoubleTapped="OnPrDoubleTapped">
            <ListBox.Styles>
              <Style Selector="StackPanel.draftpr">
                <Setter Property="Opacity" Value="0.55" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="gh:PrSummary">
                <StackPanel Margin="2" Classes.draftpr="{Binding IsDraft}">
                  <DockPanel>
                    <Panel DockPanel.Dock="Left" Width="14" VerticalAlignment="Center"
                           ToolTip.Tip="CI: green / in progress / failing">
                      <TextBlock Text="●" Foreground="#2EA043" IsVisible="{Binding ChecksGreen}" />
                      <TextBlock Text="●" Foreground="#D29922" IsVisible="{Binding ChecksPending}" />
                      <TextBlock Text="●" Foreground="#F85149" IsVisible="{Binding ChecksFailed}" />
                    </Panel>
                    <TextBlock DockPanel.Dock="Right" Text="draft" FontSize="10" Opacity="0.8"
                               VerticalAlignment="Center" IsVisible="{Binding IsDraft}" />
                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding NumberDisplay}" /> <Run Text="{Binding Title}" />
                    </TextBlock>
                  </DockPanel>
                  <TextBlock Opacity="0.6" FontSize="11" Margin="14,0,0,0">
                    <Run Text="{Binding Author.Login}" /> · <Run Text="{Binding HeadRefName}" />
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <DockPanel Grid.Column="4" Margin="6,0,0,0">
          <TextBlock DockPanel.Dock="Top" Classes="colhead" Text="{Binding State.BranchColumnHeader}" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
            <Button Content="Open Guided" Click="OnBranchOpenGuided" FontWeight="SemiBold" />
            <Button Content="Open Plain" Click="OnBranchOpenPlain" />
          </StackPanel>
          <ListBox x:Name="BranchList" ItemsSource="{Binding Branches}" DoubleTapped="OnBranchDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="docs:BranchRow">
                <StackPanel Margin="2">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" FontSize="10" Opacity="0.8" VerticalAlignment="Center"
                               Foreground="#3794FF" Text="{Binding PrTag}" IsVisible="{Binding HasPrTag}"
                               ToolTip.Tip="This branch has an open PR; '(differs)' means the local head is not what the PR shows" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding Info.Name}" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                  <TextBlock Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Info.Date}" /> · <Run Text="{Binding Info.Subject}" />
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Grid>

      <Grid RowDefinitions="Auto,*,8,Auto,*" IsVisible="{Binding SurveyStep.IsCurrent}">
        <TextBlock Grid.Row="0" FontWeight="SemiBold" FontSize="12" Text="Implementation members (click to peek)" />
        <ListBox Grid.Row="1" x:Name="SurveyImplList" ItemsSource="{Binding SurveyImpl}"
                 DoubleTapped="OnSurveyDoubleTapped" FontSize="12">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="docs:SurveyRow">
              <TextBlock FontFamily="monospace" Foreground="{Binding Foreground}" Text="{Binding Text}"
                         TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="3" FontWeight="SemiBold" FontSize="12" Text="Test members, grouped by type" />
        <ListBox Grid.Row="4" x:Name="SurveyTestList" ItemsSource="{Binding SurveyTests}"
                 DoubleTapped="OnSurveyTestDoubleTapped" FontSize="12">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="docs:SurveyRow">
              <TextBlock FontFamily="monospace" Foreground="{Binding Foreground}" Text="{Binding Text}"
                         TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Panel IsVisible="{Binding PlanStep.IsCurrent}">
        <panes:PrFilesPaneView DataContext="{Binding FilesList}" />
      </Panel>

      <ListBox ItemsSource="{Binding SweepItems}" IsVisible="{Binding SweepStep.IsCurrent}"
               x:Name="SweepList" DoubleTapped="OnSweepDoubleTapped" FontSize="12">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Traverse keeps the files list in view for viewed/depth state. -->
      <Panel IsVisible="{Binding TraverseStep.IsCurrent}">
        <panes:PrFilesPaneView DataContext="{Binding FilesList}" />
      </Panel>
      </Panel>
    </DockPanel>
  </DockPanel>
</UserControl>
