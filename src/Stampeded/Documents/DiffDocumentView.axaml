<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="using:Stampeded.Editor"
             xmlns:diff="using:Stampeded.Diff"
             x:Class="Stampeded.Documents.DiffDocumentView">
  <Grid ColumnDefinitions="*,14">
    <editor:ReviewTextEditor x:Name="Editor" IsReadOnly="True">
      <editor:ReviewTextEditor.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Go to Definition" InputGesture="F12" Click="OnCtxGoToDefinition" />
          <MenuItem Header="Find References" InputGesture="Shift+F12" Click="OnCtxFindReferences" />
          <MenuItem Header="Highlight Occurrences" Click="OnCtxHighlightOccurrences" />
          <MenuItem Header="Show Call Graph" Click="OnCtxCallGraph" />
          <Separator />
          <MenuItem Header="Next Hunk" InputGesture="N" Click="OnCtxNextHunk" />
          <MenuItem Header="Previous Hunk" InputGesture="P" Click="OnCtxPrevHunk" />
          <MenuItem Header="Toggle Blame Margin" InputGesture="B" Click="OnCtxToggleBlame" />
          <MenuItem Header="History of Selection" Click="OnCtxHistoryOfSelection" />
          <MenuItem Header="Next Uncovered Added Line" InputGesture="U" Click="OnCtxNextUncovered" />
          <MenuItem Header="Comment Here" InputGesture="C" Click="OnCtxComment" />
          <MenuItem Header="Debug Here in VS Code" Click="OnCtxDebugInVsCode" />
          <Separator />
          <MenuItem Header="Copy" InputGesture="Ctrl+C" Click="OnCtxCopy" />
        </ContextMenu>
      </editor:ReviewTextEditor.ContextMenu>
    </editor:ReviewTextEditor>
    <diff:OverviewBar x:Name="Overview" Grid.Column="1" />
    <!-- Inline comment editor, anchored at the commented line (an overlay: AvaloniaEdit
         cannot host UI between lines without corrupting the diff line map). -->
    <Popup x:Name="CommentPopup" PlacementTarget="Editor" Placement="AnchorAndGravity"
           PlacementAnchor="TopLeft" PlacementGravity="BottomRight" IsLightDismissEnabled="True">
      <Border Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="#3794FF"
              BorderThickness="1" CornerRadius="4" Padding="8" MinWidth="440" MaxWidth="620">
        <StackPanel Spacing="6">
          <TextBlock x:Name="CommentTargetText" FontSize="11" Opacity="0.7"
                     TextTrimming="CharacterEllipsis" />
          <TextBox x:Name="CommentBox" AcceptsReturn="True" MinHeight="56" MaxHeight="150"
                   TextWrapping="Wrap" FontSize="13" KeyDown="OnCommentBoxKeyDown" />
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <TextBlock FontSize="10" Opacity="0.6" VerticalAlignment="Center"
                       Text="Ctrl+Enter saves the draft, Esc closes" />
            <Button Content="Save draft" Click="OnCommentSave" FontWeight="SemiBold" />
            <Button Content="Cancel" Click="OnCommentCancel" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
