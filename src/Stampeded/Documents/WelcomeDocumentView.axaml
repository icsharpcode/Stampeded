<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="using:Stampeded.Editor"
             x:Class="Stampeded.Documents.WelcomeDocumentView">
  <editor:ReviewTextEditor x:Name="Editor"
                           IsReadOnly="True"
                           ShowLineNumbers="True" />
</UserControl>
