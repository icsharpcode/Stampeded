<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Stampeded.ConfirmWindow"
        Title="Stampeded" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False">
  <StackPanel Margin="12" Spacing="10">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="ConfirmButton" IsDefault="True" Click="OnConfirm" />
      <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
